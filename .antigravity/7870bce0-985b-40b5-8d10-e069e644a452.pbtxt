  file_change {
    absolute_path_uri: "file:///lib/memory-engine/retriever.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { MemoryStore } from \"./store\";\nimport { CompactMemoryContext, Entity, Episode, MemoryState, Learning } from \"./types\";\n\nexport interface RetrievalQuery {\n  query: string;\n  targetEntityId?: string;\n  timeWindowDays?: number;\n  maxEpisodes?: number;\n  maxEntities?: number;\n}\n\nexport class MemoryRetriever {\n  private store: MemoryStore;\n\n  constructor(userId: string) {\n    this.store = new MemoryStore(userId);\n  }\n\n  async retrieveContext(params: RetrievalQuery): Promise<CompactMemoryContext> {\n    const {\n      query,\n      targetEntityId,\n      timeWindowDays = 90,\n      maxEpisodes = 5,\n      maxEntities = 4\n    } = params;\n\n    const allEntities = await this.store.listEntities();\n    const allEpisodes = await this.store.listEpisodes(50);\n    const allRelationships = await this.store.listRelationships();\n    const allStates = await this.store.listStates();\n    const allLearnings = await this.store.listLearnings();\n    const allPatterns = await this.store.listPatterns();\n\n    const queryLower = query.toLowerCase();\n\n    // 1. Identify matched entities\n    let matchedEntities: Entity[] = [];\n    if (targetEntityId) {\n      const target = allEntities.find((e) => e.id === targetEntityId);\n      if (target) matchedEntities.push(target);\n    }\n\n    // Keyword matching on entities\n    for (const entity of allEntities) {\n      if (matchedEntities.some((m) => m.id === entity.id)) continue;\n      const canonicalMatch = queryLower.includes(entity.canonicalName.toLowerCase());\n      const aliasMatch = entity.aliases?.some((a) => queryLower.includes(a.toLowerCase()));\n      if (canonicalMatch || aliasMatch) {\n        matchedEntities.push(entity);\n      }\n    }\n\n    if (matchedEntities.length > maxEntities) {\n      matchedEntities = matchedEntities.slice(0, maxEntities);\n    }\n\n    // 2. Format entity context with relational graph\n    const relevantEntities = matchedEntities.map((ent) => {\n      const rels = allRelationships.filter(\n        (r) => (r.sourceEntityId === ent.id || r.targetEntityId === ent.id) && r.status === \"active\"\n      );\n      const relDescriptions = rels.map((r) => {\n        const otherId = r.sourceEntityId === ent.id ? r.targetEntityId : r.sourceEntityId;\n        const otherEnt = allEntities.find((e) => e.id === otherId);\n        const otherName = otherId === \"user\" ? \"You\" : otherEnt?.canonicalName || \"Unknown\";\n        return `${r.relationshipType} of ${otherName}`;\n      });\n\n      return {\n        name: ent.canonicalName,\n        type: ent.type,\n        occupation: ent.occupation,\n        description: ent.description,\n        relationships: relDescriptions\n      };\n    });\n\n    // 3. Score and rank relevant episodes\n    const matchedEntityIds = new Set(matchedEntities.map((e) => e.id));\n    const now = Date.now();\n\n    const scoredEpisodes = allEpisodes.map((ep) => {\n      let score = 0;\n      // Entity match bonus\n      if (ep.entityIds?.some((id) => matchedEntityIds.has(id))) {\n        score += 3.0;\n      }\n      // Content keyword match\n      const titleLower = ep.title.toLowerCase();\n      const summaryLower = ep.summary.toLowerCase();\n      const tokens = queryLower.split(/\\s+/).filter((t) => t.length > 3);\n      for (const token of tokens) {\n        if (titleLower.includes(token)) score += 1.5;\n        if (summaryLower.includes(token)) score += 1.0;\n      }\n      // Importance score\n      score += (ep.importanceScore || 0.5) * 1.5;\n      // Recency decay (over timeWindowDays)\n      if (ep.startTime) {\n        const ageDays = (now - new Date(ep.startTime).getTime()) / (1000 * 60 * 60 * 24);\n        if (ageDays <= timeWindowDays) {\n          score += Math.max(0, 1 - ageDays / timeWindowDays);\n        }\n      }\n      return { episode: ep, score };\n    });\n\n    scoredEpisodes.sort((a, b) => b.score - a.score);\n    const topEpisodes = scoredEpisodes\n      .slice(0, maxEpisodes)\n      .map((item) => {\n        const entityNames = (item.episode.entityIds || [])\n          .map((id) => (id === \"user\" ? \"User\" : allEntities.find((e) => e.id === id)?.canonicalName || id));\n        return {\n          title: item.episode.title,\n          summary: item.episode.summary,\n          date: item.episode.startTime || item.episode.createdAt,\n          entities: entityNames\n        };\n      });\n\n    // 4. Retrieve active internal states & learnings\n    const activeStates = allStates\n      .filter((s) => s.status === \"active\")\n      .filter((s) => {\n        if (matchedEntityIds.size > 0 && s.relatedEntityId && matchedEntityIds.has(s.relatedEntityId)) {\n          return true;\n        }\n        return queryLower.split(/\\s+/).some((t) => t.length > 3 && s.content.toLowerCase().includes(t));\n      })\n      .slice(0, 4)\n      .map((s) => ({ type: s.type, content: s.content }));\n\n    const relevantLearnings = allLearnings\n      .filter((l) => l.status === \"active\" || l.status === \"reinforced\")\n      .slice(0, 3)\n      .map((l) => l.statement);\n\n    const candidatePatterns = allPatterns\n      .filter((p) => p.status === \"confirmed_by_user\" || p.status === \"candidate\")\n      .slice(0, 2)\n      .map((p) => p.statement);\n\n    return {\n      currentInput: query,\n      relevantEntities,\n      recentEpisodes: topEpisodes,\n      relevantHistory: [],\n      relevantStates: activeStates,\n      relevantLearnings,\n      candidatePatterns,\n      uncertainties: []\n    };\n  }\n}\n"
    }
