      replacement_content: "import { generateContentWithFallback, safeParseJson } from \"@/lib/gemini\";\nimport { ExtractedMemoryBundle } from \"./types\";\n\n/**\n * Multimodal & Structured Memory Extractor\n * Transforms raw text/transcripts/media into rich, structured memory objects.\n */\nexport async function extractMemoryBundle(\n  rawContent: string,\n  referenceDate: string = new Date().toISOString(),\n  timezone: string = \"UTC\",\n  mediaContext?: Array<{ type: string; summary?: string; ocrText?: string }>\n): Promise<ExtractedMemoryBundle> {\n  const mediaDetails = mediaContext && mediaContext.length > 0\n    ? `\\nAttached Media Evidence:\\n${JSON.stringify(mediaContext, null, 2)}`\n    : \"\";\n\n  const systemInstruction = `You are the Structured Memory Interpreter of the Personal Memory Engine.\nYour goal is to parse raw user inputs into structured autobiographical memory objects.\n\nCORE PRINCIPLES & RULES:\n1. RAW TRUTH OVER SPECULATION: Only extract what the evidence supports. Do not manufacture psychological insights or assume facts.\n2. TEMPORAL RESOLUTION: The user\'s reference timestamp is \"${referenceDate}\" in timezone \"${timezone}\".\n   - \"yesterday\" means 1 day before the reference timestamp.\n   - \"last Friday\", \"three months ago\", \"this morning\" should resolve to best-estimate ISO timestamps or time precision windows.\n3. EMOTION ATTRIBUTION:\n   - \"I was irritated with CU\" -> subjectName = \"user\", targetEntityName = \"CU\", emotionType = \"irritation\"\n   - \"CU seemed irritated\" -> subjectName = \"CU\", emotionType = \"irritation\" (User observed CU\'s emotion). Do NOT mark user as subject!\n4. FIRST-CLASS LEARNINGS VS THOUGHTS:\n   - A Learning is a takeaway from experience (e.g., \"I realized I should define responsibilities before starting collaborative projects\").\n   - A State is an internal state (BELIEF, GOAL, FEAR, DECISION, QUESTION, INTENTION).\n5. RELATIONSHIPS:\n   - \"My sister called me\" -> source: \"user\", target: \"sister\'s name / Sister\", relationshipType: \"sibling\"\n   - \"CU works at Google\" -> source: \"CU\", target: \"Google\", relationshipType: \"works_at\"\n   - \"CU moved to Microsoft\" -> source: \"CU\", target: \"Microsoft\", relationshipType: \"works_at\", status: \"active\"\n\nReturn ONLY a valid JSON object matching this schema:\n{\n  \"entities\": [\n    {\n      \"canonicalName\": \"string\",\n      \"type\": \"PERSON | PLACE | ORGANIZATION | PROJECT | OBJECT | TOPIC\",\n      \"aliases\": [\"string\"],\n      \"description\": \"string\",\n      \"occupation\": \"string\",\n      \"confidence\": 0.0 - 1.0\n    }\n  ],\n  \"episodes\": [\n    {\n      \"type\": \"meeting | conversation | meal | trip | visit | work | achievement | failure | decision | conflict | celebration | purchase | experience | milestone | other\",\n      \"title\": \"string\",\n      \"summary\": \"string\",\n      \"relativeTimeExpression\": \"string (e.g., \'yesterday\', \'today\', \'last week\')\",\n      \"resolvedTime\": \"ISO 8601 string or date estimate\",\n      \"timePrecision\": \"exact_datetime | day | week | month | year | approximate_period | unknown\",\n      \"importanceScore\": 0.0 - 1.0,\n      \"associatedEntityNames\": [\"string\"],\n      \"significance\": \"string (optional)\",\n      \"expectation\": \"string (optional)\",\n      \"outcome\": \"string (optional)\"\n    }\n  ],\n  \"relationships\": [\n    {\n      \"sourceEntityName\": \"string (or \'user\')\",\n      \"targetEntityName\": \"string\",\n      \"relationshipType\": \"string\",\n      \"status\": \"active | historical\",\n      \"confidence\": 0.0 - 1.0\n    }\n  ],\n  \"emotions\": [\n    {\n      \"subjectName\": \"string (either \'user\' or the person\'s name)\",\n      \"targetEntityName\": \"string (optional)\",\n      \"emotionType\": \"string\",\n      \"intensity\": 0.0 - 1.0,\n      \"cause\": \"string\",\n      \"confidence\": 0.0 - 1.0\n    }\n  ],\n  \"states\": [\n    {\n      \"type\": \"BELIEF | VALUE | PREFERENCE | GOAL | FEAR | DREAM | INTENTION | COMMITMENT | QUESTION | DECISION | REGRET | INSIGHT | OBSERVATION\",\n      \"content\": \"string\",\n      \"relatedEntityName\": \"string (optional)\",\n      \"confidence\": 0.0 - 1.0,\n      \"importance\": 0.0 - 1.0,\n      \"status\": \"active | superseded | resolved\"\n    }\n  ],\n  \"learnings\": [\n    {\n      \"statement\": \"string\",\n      \"domain\": \"work | relationships | health | finance | productivity | creativity | personal | technical | social | other\",\n      \"confidence\": 0.0 - 1.0,\n      \"importance\": 0.0 - 1.0\n    }\n  ],\n  \"knowledge\": [\n    {\n      \"statement\": \"string\",\n      \"topic\": \"string\",\n      \"confidence\": 0.0 - 1.0\n    }\n  ]\n}`;\n\n  const prompt = `Extract all autobiographical memory components from this capture session:\nUser Input:\n\"\"\"\n${rawContent}\n\"\"\"\n${mediaDetails}\n\nAnalyze thoroughly and return the complete JSON extraction bundle.`;\n\n  const fallback: ExtractedMemoryBundle = {\n    entities: [],\n    episodes: [],\n    relationships: [],\n    emotions: [],\n    states: [],\n    learnings: [],\n    knowledge: []\n  };\n\n  try {\n    const result = await generateContentWithFallback(prompt, {\n      systemInstruction,\n      temperature: 0.1, // Low temperature for factual precision\n    });\n\n    const parsed = safeParseJson<ExtractedMemoryBundle>(result.text, fallback);\n    return {\n      entities: parsed.entities || [],\n      episodes: parsed.episodes || [],\n      relationships: parsed.relationships || [],\n      emotions: parsed.emotions || [],\n      states: parsed.states || [],\n      learnings: parsed.learnings || [],\n      knowledge: parsed.knowledge || []\n    };\n  } catch (error) {\n    console.error(\"Error in extractMemoryBundle:\", error);\n    return fallback;\n  }\n}\n"
    }
