  file_change {
    absolute_path_uri: "file:///lib/memory-engine/types.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * Personal Memory Engine - Type Definitions\n * Specification Version: 1.0\n * Principle: Understand deeply. Remember accurately. Respond naturally.\n */\n\nexport type CaptureType = \"text\" | \"audio\" | \"image\" | \"video\" | \"multimodal\" | \"mixed\";\nexport type CaptureStatus = \"pending\" | \"processing\" | \"completed\" | \"failed\";\n\nexport interface MediaAsset {\n  id: string;\n  captureSessionId: string;\n  type: \"TEXT\" | \"AUDIO\" | \"IMAGE\" | \"VIDEO\" | \"SCREENSHOT\" | \"DOCUMENT\";\n  storageUri?: string;\n  mimeType?: string;\n  duration?: number;\n  metadata?: Record<string, any>;\n  transcription?: string;\n  ocrText?: string;\n  processingStatus: \"pending\" | \"processed\" | \"failed\";\n  createdAt: string;\n}\n\nexport interface CaptureSession {\n  id: string;\n  userId: string;\n  type: CaptureType;\n  rawContent: string;\n  status: CaptureStatus;\n  timezone?: string;\n  mediaAssets?: MediaAsset[];\n  extractedSummary?: string;\n  createdAt: string;\n  updatedAt: string;\n}\n\nexport type EpisodeType =\n  | \"meeting\"\n  | \"conversation\"\n  | \"meal\"\n  | \"trip\"\n  | \"visit\"\n  | \"work\"\n  | \"achievement\"\n  | \"failure\"\n  | \"decision\"\n  | \"conflict\"\n  | \"celebration\"\n  | \"purchase\"\n  | \"experience\"\n  | \"milestone\"\n  | \"other\";\n\nexport type TimePrecision =\n  | \"exact_datetime\"\n  | \"day\"\n  | \"week\"\n  | \"month\"\n  | \"year\"\n  | \"approximate_period\"\n  | \"unknown\";\n\nexport interface Episode {\n  id: string;\n  userId: string;\n  type: EpisodeType;\n  title: string;\n  summary: string;\n  startTime?: string;\n  endTime?: string;\n  timePrecision: TimePrecision;\n  relativeTimeExpression?: string;\n  importanceScore: number; // 0.0 - 1.0\n  entityIds: string[];\n  sourceCaptureId: string;\n  significance?: string; // Turning point or meaning\n  expectation?: string;\n  outcome?: string;\n  createdAt: string;\n  updatedAt: string;\n}\n\nexport type EntityType =\n  | \"PERSON\"\n  | \"PLACE\"\n  | \"ORGANIZATION\"\n  | \"PROJECT\"\n  | \"OBJECT\"\n  | \"TOPIC\";\n\nexport interface Entity {\n  id: string;\n  userId: string;\n  type: EntityType;\n  canonicalName: string;\n  aliases: string[];\n  description?: string;\n  occupation?: string; // For PERSON\n  importanceScore: number; // 0.0 - 1.0\n  confidenceScore: number; // 0.0 - 1.0\n  status: \"active\" | \"archived\" | \"merged\";\n  mergedIntoId?: string;\n  sourceCaptureId?: string;\n  createdAt: string;\n  updatedAt: string;\n  lastMentionedAt: string;\n}\n\nexport interface Relationship {\n  id: string;\n  userId: string;\n  sourceEntityId: string; // User or Entity\n  targetEntityId: string;\n  relationshipType: string; // e.g. \"colleague\", \"sibling\", \"friend\", \"mentor\", \"works_at\", \"collaborator_on\"\n  strength: number; // 0.0 - 1.0\n  confidence: number; // 0.0 - 1.0\n  status: \"active\" | \"historical\" | \"superseded\";\n  validFrom?: string;\n  validTo?: string | null;\n  sourceCaptureId: string;\n  createdAt: string;\n  updatedAt: string;\n}\n\nexport interface Emotion {\n  id: string;\n  userId: string;\n  episodeId: string;\n  subjectEntityId: string; // \"user\" or an entityId (who felt the emotion)\n  observerEntityId?: string; // \"user\" (who observed it)\n  targetEntityId?: string; // Who or what the emotion was directed at\n  emotionType: string; // e.g. \"irritation\", \"excitement\", \"uncertainty\", \"joy\", \"relief\"\n  intensity: number; // 0.0 - 1.0\n  cause?: string;\n  confidence: number;\n  sourceCaptureId: string;\n  createdAt: string;\n}\n\nexport type MemoryStateType =\n  | \"BELIEF\"\n  | \"VALUE\"\n  | \"PREFERENCE\"\n  | \"GOAL\"\n  | \"FEAR\"\n  | \"DREAM\"\n  | \"INTENTION\"\n  | \"COMMITMENT\"\n  | \"QUESTION\"\n  | \"DECISION\"\n  | \"REGRET\"\n  | \"INSIGHT\"\n  | \"OBSERVATION\";\n\nexport interface MemoryState {\n  id: string;\n  userId: string;\n  type: MemoryStateType;\n  content: string;\n  relatedEntityId?: string;\n  relatedEpisodeId?: string;\n  confidence: number; // 0.0 - 1.0\n  importance: number; // 0.0 - 1.0\n  validFrom?: string;\n  validTo?: string | null;\n  status: \"active\" | \"superseded\" | \"resolved\" | \"abandoned\";\n  resolvedAt?: string;\n  resolution?: string;\n  sourceCaptureId: string;\n  createdAt: string;\n  updatedAt: string;\n}\n\nexport interface Learning {\n  id: string;\n  userId: string;\n  statement: string;\n  sourceEpisodeId?: string;\n  domain:\n    | \"work\"\n    | \"relationships\"\n    | \"health\"\n    | \"finance\"\n    | \"productivity\"\n    | \"creativity\"\n    | \"personal\"\n    | \"technical\"\n    | \"social\"\n    | \"other\";\n  confidence: number;\n  importance: number;\n  status: \"active\" | \"reinforced\" | \"questioned\" | \"superseded\";\n  sourceCaptureId: string;\n  createdAt: string;\n  lastReinforcedAt: string;\n}\n\nexport interface CandidatePattern {\n  id: string;\n  userId: string;\n  statement: string;\n  supportingEpisodeIds: string[];\n  confidence: number;\n  firstObserved: string;\n  lastObserved: string;\n  status: \"candidate\" | \"confirmed_by_user\" | \"dismissed\";\n  createdAt: string;\n}\n\nexport interface Knowledge {\n  id: string;\n  userId: string;\n  statement: string;\n  topic: string;\n  source?: string;\n  confidence: number;\n  acquiredAt: string;\n  sourceCaptureId: string;\n  createdAt: string;\n}\n\nexport interface MemoryProvenance {\n  id: string;\n  userId: string;\n  memoryId: string;\n  memoryType: string; // \"episode\" | \"entity\" | \"relationship\" | \"emotion\" | \"state\" | \"learning\" | \"knowledge\"\n  sourceCaptureId: string;\n  sourceMediaId?: string;\n  sourceSpan?: string;\n  extractionMethod: \"llm_structured_extraction\" | \"temporal_rule\" | \"user_edit\" | \"pattern_miner\";\n  model?: string;\n  confidence: number;\n  createdAt: string;\n}\n\nexport interface ExtractedMemoryBundle {\n  entities: Array<{\n    canonicalName: string;\n    type: EntityType;\n    aliases?: string[];\n    description?: string;\n    occupation?: string;\n    confidence: number;\n  }>;\n  episodes: Array<{\n    type: EpisodeType;\n    title: string;\n    summary: string;\n    relativeTimeExpression?: string;\n    resolvedTime?: string;\n    timePrecision: TimePrecision;\n    importanceScore: number;\n    associatedEntityNames: string[];\n    significance?: string;\n    expectation?: string;\n    outcome?: string;\n  }>;\n  relationships: Array<{\n    sourceEntityName: string; // or \"user\"\n    targetEntityName: string;\n    relationshipType: string;\n    status: \"active\" | \"historical\";\n    confidence: number;\n  }>;\n  emotions: Array<{\n    subjectName: string; // \"user\" or an entity name\n    targetEntityName?: string;\n    emotionType: string;\n    intensity: number;\n    cause?: string;\n    confidence: number;\n  }>;\n  states: Array<{\n    type: MemoryStateType;\n    content: string;\n    relatedEntityName?: string;\n    confidence: number;\n    importance: number;\n    status?: \"active\" | \"superseded\" | \"resolved\";\n  }>;\n  learnings: Array<{\n    statement: string;\n    domain: Learning[\"domain\"];\n    confidence: number;\n    importance: number;\n  }>;\n  knowledge: Array<{\n    statement: string;\n    topic: string;\n    confidence: number;\n  }>;\n}\n\nexport interface CompactMemoryContext {\n  currentInput: string;\n  relevantEntities: Array<{\n    name: string;\n    type: EntityType;\n    occupation?: string;\n    description?: string;\n    relationships: string[];\n  }>;\n  recentEpisodes: Array<{\n    title: string;\n    summary: string;\n    date: string;\n    entities: string[];\n  }>;\n  relevantHistory: string[];\n  relevantStates: Array<{\n    type: string;\n    content: string;\n  }>;\n  relevantLearnings: string[];\n  candidatePatterns: string[];\n  uncertainties: string[];\n}\n"
    }
