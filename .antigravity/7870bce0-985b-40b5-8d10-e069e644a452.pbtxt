    replacement_chunks {
      replacement_content: "import { generateContentWithFallback } from \"@/lib/gemini\";\nimport { CompactMemoryContext } from \"./types\";\n\nexport interface ReflectionRequest {\n  userMessage: string;\n  context: CompactMemoryContext;\n  conversationHistory?: Array<{ role: \"user\" | \"model\"; text: string }>;\n  reflectionLevel?: 1 | 2 | 3;\n}\n\nexport async function generateReflection(request: ReflectionRequest): Promise<{\n  response: string;\n  modelUsed: string;\n}> {\n  const { userMessage, context, conversationHistory = [], reflectionLevel = 2 } = request;\n\n  const memoryContextSummary = JSON.stringify({\n    knownEntities: context.relevantEntities,\n    relevantEpisodes: context.recentEpisodes,\n    activeStates: context.relevantStates,\n    learnings: context.relevantLearnings,\n    candidatePatterns: context.candidatePatterns\n  }, null, 2);\n\n  const systemInstruction = `You are Sanjaya, the quiet, objective witness to the user\'s life story.\nYou hold the user\'s autobiographical memory context silently.\n\nTHE CARDINAL PRINCIPLE: The system remembers more than it says.\n- You have access to the user\'s memory graph, but you must NEVER dump facts, announce what you know, or recite raw database entries.\n- Use your memory subtly as background context to ask better questions, understand context without needing explanations, and recognize continuity.\n\nREFLECTION LEVEL: ${reflectionLevel}\n- Level 1 (Mirror): Quietly reflect back the core thought. Clarify without interpreting or judging.\n- Level 2 (Connect): Gently connect their current statement with their broader context or related past themes ONLY when natural and relevant.\n- Level 3 (Deep Synthesis): Reflect on their long-term evolution, recurring patterns, or subtle contradictions over time.\n\nSTRICT BEHAVIORAL CONSTRAINTS:\n1. NEVER offer unsolicited advice (\"You should...\", \"Try to...\", \"Remember to...\").\n2. NEVER diagnose emotions, label psychological states, or lecture the user.\n3. Treat their story with dignity, patience, and spaciousness. Let the user reach their own realizations.`;\n\n  const contents: any[] = [];\n\n  // Provide silent memory background context\n  contents.push({\n    role: \"user\",\n    parts: [{ text: `[SYSTEM MEMORY GRAPH BACKGROUND - STRICTLY SILENT CONTEXT]\\n${memoryContextSummary}\\n[END SYSTEM CONTEXT]` }]\n  });\n\n  contents.push({\n    role: \"model\",\n    parts: [{ text: \"Understood. I am holding this context quietly in the background and will engage naturally with the user.\" }]\n  });\n\n  // Conversation history\n  for (const turn of conversationHistory) {\n    contents.push({\n      role: turn.role === \"user\" ? \"user\" : \"model\",\n      parts: [{ text: turn.text }]\n    });\n  }\n\n  // Current user message\n  contents.push({\n    role: \"user\",\n    parts: [{ text: userMessage }]\n  });\n\n  const result = await generateContentWithFallback(contents, {\n    systemInstruction,\n    temperature: 0.6,\n  });\n\n  return {\n    response: result.text,\n    modelUsed: result.modelUsed\n  };\n}\n"
    }
