    replacement_chunks {
      replacement_content: "import { NextResponse } from \"next/server\";\nimport { verifyUserToken } from \"@/lib/firebase-admin\";\nimport { extractMemoryBundle } from \"@/lib/memory-engine/extractor\";\nimport { MemoryReconciler } from \"@/lib/memory-engine/reconciliation\";\nimport { MemoryStore } from \"@/lib/memory-engine/store\";\nimport { CaptureSession } from \"@/lib/memory-engine/types\";\n\nexport async function POST(req: Request) {\n  try {\n    const decodedToken = await verifyUserToken(req);\n    if (!decodedToken) {\n      return NextResponse.json({ error: \"Unauthorized access\" }, { status: 401 });\n    }\n\n    let body: any = {};\n    try {\n      body = await req.json();\n    } catch {\n      return NextResponse.json({ error: \"Invalid JSON body\" }, { status: 400 });\n    }\n\n    const { content, type = \"text\", timezone = \"UTC\", mediaAssets = [] } = body;\n    if (!content || typeof content !== \"string\" || !content.trim()) {\n      return NextResponse.json({ error: \"Capture content is required\" }, { status: 400 });\n    }\n\n    const captureId = `cap_${Date.now()}_${Math.random().toString(36).substring(2, 9)}`;\n    const now = new Date().toISOString();\n\n    const captureSession: CaptureSession = {\n      id: captureId,\n      userId: decodedToken.uid,\n      type,\n      rawContent: content,\n      status: \"processing\",\n      timezone,\n      mediaAssets,\n      createdAt: now,\n      updatedAt: now\n    };\n\n    const store = new MemoryStore(decodedToken.uid);\n    await store.saveCapture(captureSession);\n\n    // Run extraction & reconciliation\n    const bundle = await extractMemoryBundle(content, now, timezone, mediaAssets);\n    const reconciler = new MemoryReconciler(decodedToken.uid);\n    const reconciliationResult = await reconciler.reconcileCapture(captureSession, bundle);\n\n    // Update capture status to completed\n    await store.saveCapture({\n      ...captureSession,\n      status: \"completed\",\n      extractedSummary: reconciliationResult.createdEpisodes[0]?.summary || \"Extracted memory elements\",\n      updatedAt: new Date().toISOString()\n    });\n\n    return NextResponse.json({\n      success: true,\n      captureId,\n      status: \"completed\",\n      extractedBundle: bundle,\n      reconciliation: {\n        createdEntitiesCount: reconciliationResult.createdEntities.length,\n        createdEpisodesCount: reconciliationResult.createdEpisodes.length,\n        createdRelationshipsCount: reconciliationResult.createdRelationships.length,\n        createdEmotionsCount: reconciliationResult.createdEmotions.length,\n        createdStatesCount: reconciliationResult.createdStates.length,\n        createdLearningsCount: reconciliationResult.createdLearnings.length\n      }\n    });\n\n  } catch (error: any) {\n    console.error(\"Error in /api/v1/capture:\", error);\n    return NextResponse.json({ error: error?.message || \"Internal server error\" }, { status: 500 });\n  }\n}\n\nexport async function GET(req: Request) {\n  try {\n    const decodedToken = await verifyUserToken(req);\n    if (!decodedToken) {\n      return NextResponse.json({ error: \"Unauthorized access\" }, { status: 401 });\n    }\n\n    const store = new MemoryStore(decodedToken.uid);\n    const captures = await store.listCaptures(20);\n\n    return NextResponse.json({ captures });\n  } catch (error: any) {\n    console.error(\"Error listing captures:\", error);\n    return NextResponse.json({ error: error?.message || \"Internal server error\" }, { status: 500 });\n  }\n}\n"
    }
