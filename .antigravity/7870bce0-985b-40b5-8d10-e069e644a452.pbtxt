  file_change {
    absolute_path_uri: "file:///app/page.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "\"use\" client;\n\nimport React, { useState, useEffect, useRef } from \"react\";\nimport { useJournal, JournalEntry, UserMemory } from \"@/lib/context/JournalContext\";\nimport { \n  motion, \n  AnimatePresence \n} from \"motion/react\";\nimport { \n  PenLine, \n  BookOpen, \n  Sparkles, \n  Brain, \n  Trash2, \n  LogOut, \n  Search, \n  Check, \n  X, \n  MessageSquare, \n  Send, \n  Loader2, \n  Maximize2, \n  Minimize2, \n  ChevronRight, \n  Plus, \n  Edit3,\n  Calendar,\n  AlertCircle,\n  HelpCircle,\n  Clock\n} from \"lucide-react\";\n\ntype ActiveTab = \"entries\" | \"memories\" | \"insights\";\n\nexport default function Page() {\n  const {\n    user,\n    loading,\n    entries,\n    memories,\n    insights,\n    insightsLoading,\n    activeEntry,\n    isAnalyzing,\n    isChatting,\n    saveError,\n    \n    signIn,\n    logOut,\n    setActiveEntry,\n    createEmptyEntry,\n    saveEntryContent,\n    deleteJournalEntry,\n    analyzeActiveEntry,\n    sendMessageToActiveEntry,\n    fetchInsights,\n    \n    approveMemory,\n    editMemory,\n    deleteMemory,\n    dismissMemorySuggestion\n  } = useJournal();\n\n  const [activeTab, setActiveTab] = useState<ActiveTab>(\"entries\");\n  const [searchQuery, setSearchQuery] = useState(\"\");\n  const [editorContent, setEditorContent] = useState(\"\");\n  const [isFocusMode, setIsFocusMode] = useState(false);\n  const [chatMessage, setChatMessage] = useState(\"\");\n  const [editingMemoryId, setEditingMemoryId] = useState<string | null>(null);\n  const [editingMemoryText, setEditingMemoryText] = useState(\"\");\n  const [isRightPanelOpen, setIsRightPanelOpen] = useState(true);\n\n  const chatEndRef = useRef<HTMLDivElement>(null);\n  const autosaveTimerRef = useRef<NodeJS.Timeout | null>(null);\n\n  // Sync editor field when user changes the active entry\n  useEffect(() => {\n    if (activeEntry) {\n      setEditorContent(activeEntry.content || \"\");\n    } else {\n      setEditorContent(\"\");\n    }\n  }, [activeEntry?.id]);\n\n  // Handle auto-scrolling to the end of the chat conversation\n  useEffect(() => {\n    if (chatEndRef.current) {\n      chatEndRef.current.scrollIntoView({ behavior: \"smooth\" });\n    }\n  }, [activeEntry?.chatHistory?.length, isChatting]);\n\n  // Handle local autosave with a gentle 1.2-second debounce\n  const handleEditorChange = (e: React.ChangeEvent<HTMLTextAreaElement>) => {\n    const nextContent = e.target.value;\n    setEditorContent(nextContent);\n\n    if (!activeEntry) return;\n\n    if (autosaveTimerRef.current) {\n      clearTimeout(autosaveTimerRef.current);\n    }\n\n    autosaveTimerRef.current = setTimeout(() => {\n      saveEntryContent(activeEntry.id, nextContent);\n    }, 1200);\n  };\n\n  // Clean up autosave timers on unmount\n  useEffect(() => {\n    return () => {\n      if (autosaveTimerRef.current) clearTimeout(autosaveTimerRef.current);\n    };\n  }, []);\n\n  // Filter entries in real-time based on search input\n  const filteredEntries = entries.filter((entry) => {\n    const q = searchQuery.toLowerCase().trim();\n    if (!q) return true;\n    return (\n      entry.content.toLowerCase().includes(q) || \n      entry.title.toLowerCase().includes(q)\n    );\n  });\n\n  const handleSendMessage = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!chatMessage.trim() || !activeEntry) return;\n    const msg = chatMessage.trim();\n    setChatMessage(\"\");\n    await sendMessageToActiveEntry(msg);\n  };\n\n  const handleCreateEntry = async () => {\n    const newEntry = await createEmptyEntry();\n    setActiveTab(\"entries\");\n    setIsFocusMode(false);\n  };\n\n  const handleSelectEntry = (entry: JournalEntry) => {\n    setActiveEntry(entry);\n    setActiveTab(\"entries\");\n  };\n\n  // Stage editing for a memory\n  const startEditMemory = (m: UserMemory) => {\n    setEditingMemoryId(m.id);\n    setEditingMemoryText(m.content);\n  };\n\n  const handleSaveMemoryEdit = async (id: string) => {\n    if (!editingMemoryText.trim()) return;\n    await editMemory(id, editingMemoryText.trim());\n    setEditingMemoryId(null);\n  };\n\n  // Fetch insights when the Insights tab is explicitly clicked and we don\'t have them\n  useEffect(() => {\n    if (activeTab === \"insights\" && user && !insights && !insightsLoading) {\n      fetchInsights();\n    }\n  }, [activeTab, user]);\n\n  // Unauthenticated session loading state\n  if (loading) {\n    return (\n      <div className=\"min-h-screen bg-[#FDFBF9] flex flex-col items-center justify-center p-6 text-stone-800\">\n        <motion.div \n          animate={{ scale: [1, 1.05, 1], opacity: [0.6, 1, 0.6] }}\n          transition={{ repeat: Infinity, duration: 2, ease: \"easeInOut\" }}\n          className=\"flex flex-col items-center\"\n        >\n          <div className=\"w-12 h-12 rounded-full bg-stone-100 flex items-center justify-center mb-4 border border-stone-200\">\n            <Brain className=\"w-6 h-6 text-stone-600 animate-pulse\" />\n          </div>\n          <p className=\"text-sm font-sans tracking-widest text-stone-400 uppercase\">Opening Your Thinking Space</p>\n        </motion.div>\n      </div>\n    );\n  }\n\n  // Unauthenticated Welcome/Sign-in state\n  if (!user) {\n    return (\n      <div className=\"min-h-screen bg-[#FDFBF9] flex flex-col justify-between p-6 md:p-12 text-stone-800 selection:bg-stone-100\">\n        <header className=\"max-w-7xl mx-auto w-full flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <Brain className=\"w-5 h-5 text-stone-700\" />\n            <span className=\"font-sans text-sm tracking-wider font-semibold text-stone-800\">GEMINI JOURNAL</span>\n          </div>\n          <div className=\"text-xs text-stone-400 font-sans tracking-wide\">PRIVATE & SECURE</div>\n        </header>\n\n        <main className=\"max-w-2xl mx-auto w-full flex flex-col items-center text-center my-12\">\n          <motion.div\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 1, ease: [0.16, 1, 0.3, 1] }}\n            className=\"flex flex-col items-center\"\n          >\n            <div className=\"h-10 px-4 py-1 rounded-full bg-stone-100 border border-stone-200/60 flex items-center gap-2 mb-8\">\n              <Sparkles className=\"w-3.5 h-3.5 text-stone-500 animate-pulse\" />\n              <span className=\"text-xs font-sans tracking-wide text-stone-600 font-medium\">An Intelligent Thinking Companion</span>\n            </div>\n\n            <h1 className=\"font-serif text-4xl sm:text-5xl md:text-6xl text-stone-900 leading-tight tracking-tight mb-6 max-w-xl\">\n              Write freely. Understand deeply.\n            </h1>\n\n            <p className=\"font-sans text-stone-600 text-base md:text-lg leading-relaxed mb-10 max-w-lg\">\n              A private, beautifully quiet canvas where you can pour everything on your mind. Gemini helps you capture core themes, surface insights, and trace long-term connections.\n            </p>\n\n            <motion.button\n              whileHover={{ scale: 1.01 }}\n              whileTap={{ scale: 0.99 }}\n              onClick={signIn}\n              id=\"google-signin-btn\"\n              className=\"px-8 py-3.5 bg-stone-900 hover:bg-stone-800 text-[#FAF9F6] font-sans text-sm font-medium rounded-full shadow-sm flex items-center gap-3 transition-colors cursor-pointer\"\n            >\n              <svg className=\"w-4 h-4 fill-current\" viewBox=\"0 0 24 24\">\n                <path d=\"M12.24 10.285V13.4h6.887C18.2 15.614 15.645 18 12.24 18c-3.86 0-7-3.14-7-7s3.14-7 7-7c1.7 0 3.25.61 4.45 1.615l2.4-2.4C17.3 1.63 14.93 1 12.24 1 6.59 1 2 5.59 2 11.24s4.59 10.24 10.24 10.24c5.9 0 9.81-4.15 9.81-10 0-.67-.06-1.18-.18-1.7H12.24z\"/>\n              </svg>\n              Continue with Google Account\n            </motion.button>\n\n            <div className=\"mt-12 flex items-center gap-8 text-xs text-stone-400 font-sans tracking-wide border-t border-stone-200/50 pt-8 w-full justify-center\">\n              <div className=\"flex items-center gap-1.5\">\n                <Check className=\"w-3.5 h-3.5 text-stone-500\" />\n                Firestore User Isolation\n              </div>\n              <div className=\"flex items-center gap-1.5\">\n                <Check className=\"w-3.5 h-3.5 text-stone-500\" />\n                Zero-Key Hardcoding\n              </div>\n            </div>\n          </motion.div>\n        </main>\n\n        <footer className=\"max-w-7xl mx-auto w-full text-center text-xs text-stone-400 font-sans tracking-wider py-4\">\n          \302\251 {new Date().getFullYear()} Personal Gemini Journal. All rights reserved.\n        </footer>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-[#FAF9F6] flex text-stone-800 selection:bg-stone-100 overflow-hidden font-sans\">\n      {/* 1. Left Sidebar - Journal Settings & Feeds */}\n      <AnimatePresence>\n        {!isFocusMode && (\n          <motion.aside\n            initial={{ width: 0, opacity: 0 }}\n            animate={{ width: 320, opacity: 1 }}\n            exit={{ width: 0, opacity: 0 }}\n            transition={{ type: \"spring\", damping: 25, stiffness: 180 }}\n            className=\"hidden md:flex flex-col border-r border-stone-200/70 bg-[#FAF9F6] shrink-0 overflow-hidden\"\n          >\n            {/* Sidebar Header */}\n            <div className=\"p-5 flex flex-col border-b border-stone-200/50\">\n              <div className=\"flex items-center justify-between mb-4\">\n                <div className=\"flex items-center gap-1.5\">\n                  <Brain className=\"w-4 h-4 text-stone-700\" />\n                  <span className=\"text-xs font-semibold tracking-wider text-stone-800\">GEMINI JOURNAL</span>\n                </div>\n                <button \n                  onClick={logOut}\n                  title=\"Sign Out\"\n                  className=\"p-1.5 hover:bg-stone-100 rounded-full text-stone-500 hover:text-stone-800 transition-colors cursor-pointer\"\n                >\n                  <LogOut className=\"w-4 h-4\" />\n                </button>\n              </div>\n\n              {/* User badge */}\n              <div className=\"flex items-center gap-3 py-1.5\">\n                {user.photoURL ? (\n                  <img src={user.photoURL} alt={user.displayName || \"User\"} referrerPolicy=\"no-referrer\" className=\"w-7 h-7 rounded-full border border-stone-200\" />\n                ) : (\n                  <div className=\"w-7 h-7 rounded-full bg-stone-200 flex items-center justify-center text-stone-600 font-medium text-xs\">\n                    {user.displayName?.[0] || user.email?.[0] || \"U\"}\n                  </div>\n                )}\n                <div className=\"flex flex-col min-w-0\">\n                  <span className=\"text-xs font-medium text-stone-700 truncate\">{user.displayName || \"Journal Writer\"}</span>\n                  <span className=\"text-[10px] text-stone-400 truncate\">{user.email}</span>\n                </div>\n              </div>\n\n              {/* Navigation Tabs */}\n              <div className=\"grid grid-cols-3 gap-1 bg-stone-100/80 p-1 rounded-lg mt-4\">\n                <button\n                  onClick={() => setActiveTab(\"entries\")}\n                  className={`py-1.5 text-xs font-medium rounded-md transition-all cursor-pointer ${\n                    activeTab === \"entries\" \n                      ? \"bg-white text-stone-800 shadow-sm\" \n                      : \"text-stone-500 hover:text-stone-800\"\n                  }`}\n                >\n                  Reflections\n                </button>\n                <button\n                  onClick={() => setActiveTab(\"memories\")}\n                  className={`py-1.5 text-xs font-medium rounded-md transition-all cursor-pointer ${\n                    activeTab === \"memories\" \n                      ? \"bg-white text-stone-800 shadow-sm\" \n                      : \"text-stone-500 hover:text-stone-800\"\n                  }`}\n                >\n                  Memories\n                </button>\n                <button\n                  onClick={() => setActiveTab(\"insights\")}\n                  className={`py-1.5 text-xs font-medium rounded-md transition-all cursor-pointer ${\n                    activeTab === \"insights\" \n                      ? \"bg-white text-stone-800 shadow-sm\" \n                      : \"text-stone-500 hover:text-stone-800\"\n                  }`}\n                >\n                  Insights\n                </button>\n              </div>\n            </div>\n\n            {/* Sidebar Feed based on Active Tab */}\n            <div className=\"flex-1 overflow-y-auto min-h-0\">\n              {activeTab === \"entries\" && (\n                <div className=\"p-4 flex flex-col gap-3\">\n                  <div className=\"flex items-center gap-2\">\n                    <button\n                      onClick={handleCreateEntry}\n                      id=\"create-new-entry-btn\"\n                      className=\"flex-1 flex items-center justify-center gap-1.5 py-2.5 bg-stone-900 hover:bg-stone-800 text-[#FAF9F6] rounded-md text-xs font-medium transition-colors cursor-pointer\"\n                    >\n                      <Plus className=\"w-3.5 h-3.5\" />\n                      Write New Reflection\n                    </button>\n                  </div>\n\n                  {/* Search Bar */}\n                  <div className=\"relative\">\n                    <Search className=\"w-3.5 h-3.5 text-stone-400 absolute left-3 top-3\" />\n                    <input\n                      type=\"text\"\n                      placeholder=\"Search thoughts & keywords...\"\n                      value={searchQuery}\n                      onChange={(e) => setSearchQuery(e.target.value)}\n                      className=\"w-full bg-stone-100 border border-stone-200/50 hover:bg-stone-100/50 focus:bg-white focus:border-stone-300 outline-none text-xs rounded-md pl-9 pr-4 py-2.5 transition-all text-stone-800\"\n                    />\n                    {searchQuery && (\n                      <button \n                        onClick={() => setSearchQuery(\"\")} \n                        className=\"p-1 absolute right-2.5 top-2.5 hover:bg-stone-200 text-stone-400 hover:text-stone-700 rounded-full\"\n                      >\n                        <X className=\"w-3 h-3\" />\n                      </button>\n                    )}\n                  </div>\n\n                  {/* Entry list items */}\n                  <div className=\"flex flex-col gap-1.5 mt-2\">\n                    {filteredEntries.length === 0 ? (\n                      <div className=\"text-center py-10 px-4 text-stone-400\">\n                        <BookOpen className=\"w-6 h-6 mx-auto mb-2 opacity-30 text-stone-500\" />\n                        <p className=\"text-xs font-medium\">No reflections found</p>\n                        <p className=\"text-[10px] opacity-70 mt-1\">Start writing to capture your mind.</p>\n                      </div>\n                    ) : (\n                      filteredEntries.map((entry) => {\n                        const isActive = activeEntry?.id === entry.id;\n                        return (\n                          <div\n                            key={entry.id}\n                            onClick={() => handleSelectEntry(entry)}\n                            className={`group relative p-3.5 rounded-lg text-left transition-all border cursor-pointer ${\n                              isActive \n                                ? \"bg-white border-stone-300 shadow-sm\" \n                                : \"bg-transparent border-transparent hover:bg-stone-100 hover:border-stone-200\"\n                            }`}\n                          >\n                            <div className=\"flex items-center justify-between gap-2 mb-1.5\">\n                              <span className=\"text-[10px] text-stone-400 font-medium tracking-wide flex items-center gap-1\">\n                                <Clock className=\"w-3 h-3 text-stone-300\" />\n                                {new Date(entry.createdAt).toLocaleDateString(undefined, { month: \"short\", day: \"numeric\" })}\n                              </span>\n                              \n                              {/* Summary check tag */}\n                              {entry.summary && (\n                                <span className=\"text-[9px] px-1.5 py-0.5 bg-stone-100 text-stone-500 rounded font-medium\">Analyzed</span>\n                              )}\n                            </div>\n\n                            <h3 className={`text-xs font-semibold truncate mb-1 ${isActive ? \"text-stone-900 font-serif\" : \"text-stone-800 font-serif\"}`}>\n                              {entry.title || \"Untitled Entry\"}\n                            </h3>\n\n                            <p className=\"text-[11px] text-stone-400 line-clamp-2 leading-relaxed\">\n                              {entry.content.trim() ? entry.content : \"Empty draft...\"}\n                            </p>\n\n                            <button\n                              onClick={(e) => {\n                                e.stopPropagation();\n                                if (confirm(\"Delete this reflection forever?\")) {\n                                  deleteJournalEntry(entry.id);\n                                }\n                              }}\n                              className=\"absolute right-2 bottom-2 p-1 bg-white md:opacity-0 group-hover:opacity-100 text-stone-400 hover:text-red-500 border border-stone-100 hover:border-stone-200 rounded transition-all cursor-pointer\"\n                              title=\"Delete reflection\"\n                            >\n                              <Trash2 className=\"w-3 h-3\" />\n                            </button>\n                          </div>\n                        );\n                      })\n                    )}\n                  </div>\n                </div>\n              )}\n\n              {activeTab === \"memories\" && (\n                <div className=\"p-4 flex flex-col gap-3\">\n                  <div className=\"flex items-center justify-between mb-2\">\n                    <h3 className=\"text-xs font-semibold text-stone-700 uppercase tracking-wider\">Memory Canvas</h3>\n                    <span className=\"text-[10px] px-2 py-0.5 bg-stone-100 text-stone-500 rounded-full font-medium\">\n                      {memories.filter((m) => m.status === \"approved\").length} active\n                    </span>\n                  </div>\n\n                  <p className=\"text-[11px] text-stone-400 leading-relaxed mb-3\">\n                    These are explicit facts or insights Gemini remembers about you to maintain context during your sessions.\n                  </p>\n\n                  <div className=\"flex flex-col gap-2\">\n                    {memories.filter((m) => m.status === \"approved\").length === 0 ? (\n                      <div className=\"text-center py-10 px-4 text-stone-400 border border-dashed border-stone-200 rounded-lg\">\n                        <Brain className=\"w-5 h-5 mx-auto mb-2 opacity-30 text-stone-500\" />\n                        <p className=\"text-xs font-medium\">Memory is empty</p>\n                        <p className=\"text-[10px] opacity-70 mt-1\">When Gemini analyzes your reflections, approved items will surface here.</p>\n                      </div>\n                    ) : (\n                      memories\n                        .filter((m) => m.status === \"approved\")\n                        .map((memory) => (\n                          <div key={memory.id} className=\"p-3 bg-white border border-stone-200/80 rounded-lg group transition-all\">\n                            {editingMemoryId === memory.id ? (\n                              <div className=\"flex flex-col gap-2\">\n                                <textarea\n                                  value={editingMemoryText}\n                                  onChange={(e) => setEditingMemoryText(e.target.value)}\n                                  className=\"w-full p-2 text-xs border border-stone-200 rounded-md outline-none bg-stone-50 focus:bg-white focus:border-stone-400 font-sans leading-relaxed text-stone-800\"\n                                  rows={2}\n                                />\n                                <div className=\"flex gap-1.5 justify-end\">\n                                  <button\n                                    onClick={() => setEditingMemoryId(null)}\n                                    className=\"px-2 py-1 bg-stone-100 hover:bg-stone-200 text-stone-600 rounded text-[10px] font-medium cursor-pointer\"\n                                  >\n                                    Cancel\n                                  </button>\n                                  <button\n                                    onClick={() => handleSaveMemoryEdit(memory.id)}\n                                    className=\"px-2.5 py-1 bg-stone-950 hover:bg-stone-800 text-white rounded text-[10px] font-medium cursor-pointer\"\n                                  >\n                                    Save\n                                  </button>\n                                </div>\n                              </div>\n                            ) : (\n                              <div className=\"flex flex-col justify-between h-full gap-2\">\n                                <p className=\"text-xs text-stone-600 leading-relaxed font-serif\">\n                                  \"{memory.content}\"\n                                </p>\n                                <div className=\"flex items-center justify-between border-t border-stone-100 pt-2 opacity-0 group-hover:opacity-100 transition-opacity\">\n                                  <span className=\"text-[9px] text-stone-400\">\n                                    {new Date(memory.createdAt).toLocaleDateString()}\n                                  </span>\n                                  <div className=\"flex gap-1\">\n                                    <button\n                                      onClick={() => startEditMemory(memory)}\n                                      className=\"p-1 text-stone-400 hover:text-stone-700 hover:bg-stone-50 rounded\"\n                                      title=\"Edit Memory\"\n                                    >\n                                      <Edit3 className=\"w-3 h-3\" />\n                                    </button>\n                                    <button\n                                      onClick={() => deleteMemory(memory.id)}\n                                      className=\"p-1 text-stone-400 hover:text-red-500 hover:bg-stone-50 rounded\"\n                                      title=\"Delete Memory\"\n                                    >\n                                      <Trash2 className=\"w-3 h-3\" />\n                                    </button>\n                                  </div>\n                                </div>\n                              </div>\n                            )}\n                          </div>\n                        ))\n                    )}\n                  </div>\n                </div>\n              )}\n\n              {activeTab === \"insights\" && (\n                <div className=\"p-4 flex flex-col gap-3\">\n                  <h3 className=\"text-xs font-semibold text-stone-700 uppercase tracking-wider\">Pattern Synthesis</h3>\n                  \n                  <button\n                    onClick={fetchInsights}\n                    disabled={insightsLoading}\n                    className=\"w-full flex items-center justify-center gap-2 py-2 border border-stone-200 hover:bg-stone-100 text-stone-700 rounded-md text-xs font-medium transition-colors cursor-pointer disabled:opacity-50\"\n                  >\n                    {insightsLoading ? (\n                      <>\n                        <Loader2 className=\"w-3.5 h-3.5 animate-spin\" />\n                        Analyzing Canvas...\n                      </>\n                    ) : (\n                      <>\n                        <Sparkles className=\"w-3.5 h-3.5 text-stone-500 animate-pulse\" />\n                        Regenerate Patterns\n                      </>\n                    )}\n                  </button>\n\n                  <div className=\"mt-2 text-stone-600 space-y-4\">\n                    {insightsLoading ? (\n                      <div className=\"py-12 flex flex-col items-center justify-center text-stone-400 text-center\">\n                        <Loader2 className=\"w-6 h-6 animate-spin mb-3 text-stone-400\" />\n                        <p className=\"text-xs font-medium\">Weaving long-term reflections...</p>\n                        <p className=\"text-[10px] opacity-70 mt-1 max-w-xs px-4\">Gemini is searching across entries to map behavioral loops and growth indicators.</p>\n                      </div>\n                    ) : insights ? (\n                      <div className=\"space-y-4\">\n                        <div className=\"p-3.5 bg-stone-100/50 rounded-lg border border-stone-200/40\">\n                          <h4 className=\"text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-2\">Synthesis Summary</h4>\n                          <p className=\"text-xs leading-relaxed text-stone-700 font-serif\">\n                            {insights.overallSummary}\n                          </p>\n                        </div>\n\n                        {/* Recurring Themes */}\n                        {insights.keyThemes?.length > 0 && (\n                          <div>\n                            <h4 className=\"text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-2\">Long-Term Themes</h4>\n                            <div className=\"space-y-2\">\n                              {insights.keyThemes.map((theme, i) => (\n                                <div key={i} className=\"p-3 bg-white border border-stone-200/50 rounded-lg\">\n                                  <div className=\"flex justify-between items-center mb-1\">\n                                    <span className=\"text-xs font-semibold text-stone-800 font-serif\">{theme.name}</span>\n                                    <span className=\"text-[9px] font-sans px-1.5 py-0.5 bg-stone-100 rounded text-stone-500 font-medium\">\n                                      {theme.count} refs\n                                    </span>\n                                  </div>\n                                  <p className=\"text-[11px] text-stone-500 leading-relaxed\">\n                                    {theme.description}\n                                  </p>\n                                </div>\n                              ))}\n                            </div>\n                          </div>\n                        )}\n\n                        {/* Unfinished Thoughts */}\n                        {insights.unfinishedThoughts?.length > 0 && (\n                          <div>\n                            <h4 className=\"text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-2\">Open Loops</h4>\n                            <ul className=\"space-y-1.5 list-disc pl-4 text-[11px] text-stone-600 leading-relaxed\">\n                              {insights.unfinishedThoughts.map((t, idx) => (\n                                <li key={idx}>{t}</li>\n                              ))}\n                            </ul>\n                          </div>\n                        )}\n\n                        {/* Growth Indicators */}\n                        {insights.growthIndicators?.length > 0 && (\n                          <div>\n                            <h4 className=\"text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-2\">Growth Signs</h4>\n                            <ul className=\"space-y-1.5 list-disc pl-4 text-[11px] text-stone-600 leading-relaxed\">\n                              {insights.growthIndicators.map((g, idx) => (\n                                <li key={idx} className=\"marker:text-emerald-500\">{g}</li>\n                              ))}\n                            </ul>\n                          </div>\n                        )}\n\n                        {/* Custom Writing Prompt Inspirations */}\n                        {insights.gentleInspirations?.length > 0 && (\n                          <div className=\"pt-2 border-t border-stone-200/50\">\n                            <h4 className=\"text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-2\">Suggested Writing Prompts</h4>\n                            <div className=\"space-y-2\">\n                              {insights.gentleInspirations.map((promptText, idx) => (\n                                <div \n                                  key={idx} \n                                  onClick={() => {\n                                    handleCreateEntry().then(newEntry => {\n                                      saveEntryContent(newEntry.id, `Reflection Prompt: ${promptText}\\n\\n`);\n                                    });\n                                  }}\n                                  className=\"p-2.5 bg-white border border-stone-200/60 hover:border-stone-400/80 rounded-md transition-all cursor-pointer text-[11px] text-stone-600 leading-relaxed hover:text-stone-800\"\n                                >\n                                  {promptText}\n                                </div>\n                              ))}\n                            </div>\n                          </div>\n                        )}\n                      </div>\n                    ) : (\n                      <div className=\"text-center py-10 px-4 text-stone-400 border border-dashed border-stone-200 rounded-lg\">\n                        <Sparkles className=\"w-5 h-5 mx-auto mb-2 opacity-30 text-stone-500\" />\n                        <p className=\"text-xs font-medium\">No patterns recorded</p>\n                        <p className=\"text-[10px] opacity-70 mt-1\">Once you have written entries, click the button above to generate a deep synthesis.</p>\n                      </div>\n                    )}\n                  </div>\n                </div>\n              )}\n            </div>\n          </motion.aside>\n        )}\n      </AnimatePresence>\n\n      {/* 2. Center Panel - Focus / Writing space */}\n      <main className=\"flex-1 flex flex-col min-w-0 bg-[#FDFBF9] overflow-hidden relative\">\n        {/* Top Control Bar */}\n        <header className=\"h-14 px-6 border-b border-stone-200/40 flex items-center justify-between shrink-0 bg-[#FDFBF9]\">\n          <div className=\"flex items-center gap-2\">\n            {/* Mobile menu trigger */}\n            <button\n              onClick={() => setIsFocusMode(!isFocusMode)}\n              className=\"p-2 hover:bg-stone-100 rounded-full text-stone-500 hover:text-stone-800 md:hidden cursor-pointer\"\n            >\n              <PenLine className=\"w-4 h-4\" />\n            </button>\n\n            {/* Focus toggle */}\n            <button\n              onClick={() => setIsFocusMode(!isFocusMode)}\n              className=\"p-2 hover:bg-stone-100 rounded-full text-stone-400 hover:text-stone-700 transition-colors hidden md:block cursor-pointer\"\n              title={isFocusMode ? \"Exit distraction-free writing\" : \"Enter distraction-free writing\"}\n            >\n              {isFocusMode ? <Minimize2 className=\"w-4 h-4\" /> : <Maximize2 className=\"w-4 h-4\" />}\n            </button>\n\n            {/* Sync state message */}\n            <span className=\"text-[10px] text-stone-400 font-medium tracking-wider uppercase flex items-center gap-1.5\">\n              {activeEntry ? (\n                <>\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block animate-pulse\"></span>\n                  Active Entry: {activeEntry.title}\n                </>\n              ) : (\n                \"Personal Journal Canvas\"\n              )}\n            </span>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            {/* Save error block */}\n            {saveError && (\n              <div className=\"flex items-center gap-1.5 px-3 py-1 bg-red-50 border border-red-200 text-red-600 rounded text-[10px] max-w-xs truncate\">\n                <AlertCircle className=\"w-3 h-3 flex-shrink-0\" />\n                <span>{saveError}</span>\n              </div>\n            )}\n\n            {/* \"Make Sense of This\" Quick Trigger when activeEntry exists */}\n            {activeEntry && activeEntry.content.trim() && (\n              <button\n                onClick={analyzeActiveEntry}\n                disabled={isAnalyzing}\n                className=\"px-4 py-1.5 bg-stone-900 hover:bg-stone-800 disabled:bg-stone-200 text-[#FAF9F6] disabled:text-stone-400 rounded-full text-xs font-medium flex items-center gap-1.5 transition-all shadow-sm cursor-pointer\"\n              >\n                {isAnalyzing ? (\n                  <>\n                    <Loader2 className=\"w-3 h-3 animate-spin\" />\n                    Reflecting...\n                  </>\n                ) : (\n                  <>\n                    <Sparkles className=\"w-3 h-3 text-stone-200\" />\n                    Make Sense of This\n                  </>\n                )}\n              </button>\n            )}\n\n            {/* Right Panel Toggle on Desktop */}\n            {activeEntry && (\n              <button\n                onClick={() => setIsRightPanelOpen(!isRightPanelOpen)}\n                className={`p-2 hover:bg-stone-100 rounded-full transition-colors hidden md:block cursor-pointer ${\n                  isRightPanelOpen ? \"text-stone-800 bg-stone-50\" : \"text-stone-400\"\n                }`}\n                title=\"Toggle AI reflection layer\"\n              >\n                <Brain className=\"w-4 h-4\" />\n              </button>\n            )}\n          </div>\n        </header>\n\n        {/* The active editor stage */}\n        <div className=\"flex-1 overflow-y-auto flex justify-center p-6 md:p-12 min-h-0 bg-[#FDFBF9]\">\n          {activeEntry ? (\n            <div className=\"max-w-2xl w-full flex flex-col h-full\">\n              {/* Date Eyebrow */}\n              <div className=\"text-xs text-stone-400 font-sans tracking-wide mb-3 flex items-center gap-1.5\">\n                <Calendar className=\"w-3.5 h-3.5 text-stone-300\" />\n                {new Date(activeEntry.createdAt).toLocaleDateString(undefined, { \n                  weekday: \"long\", \n                  year: \"numeric\", \n                  month: \"long\", \n                  day: \"numeric\" \n                })}\n              </div>\n\n              {/* Title input derived from content or customized */}\n              <h2 className=\"font-serif text-2xl md:text-3xl font-semibold text-stone-900 outline-none border-b border-transparent mb-6\">\n                {activeEntry.title || \"Untitled Reflection\"}\n              </h2>\n\n              {/* Distraction-free Writing Field */}\n              <textarea\n                value={editorContent}\n                onChange={handleEditorChange}\n                placeholder=\"Start writing freely... Pour out anything on your mind: thoughts, anxieties, plans, questions, decisions, or raw notes. Let Gemini help organize it once you are ready.\"\n                className=\"flex-1 w-full font-serif text-stone-800 text-base md:text-lg leading-relaxed placeholder-stone-300 outline-none resize-none bg-transparent min-h-[300px]\"\n              />\n\n              <div className=\"flex items-center justify-between border-t border-stone-200/50 pt-4 mt-6 text-stone-400 font-sans text-xs\">\n                <div className=\"flex items-center gap-2\">\n                  <span>{editorContent.split(/\\s+/).filter(Boolean).length} words</span>\n                  <span>\342\200\242</span>\n                  <span>{editorContent.length} characters</span>\n                </div>\n                <span>Autosaved locally & cloud synced</span>\n              </div>\n            </div>\n          ) : (\n            <div className=\"max-w-md w-full flex flex-col items-center justify-center text-center p-8 my-auto\">\n              <motion.div\n                initial={{ opacity: 0, scale: 0.95 }}\n                animate={{ opacity: 1, scale: 1 }}\n                className=\"flex flex-col items-center\"\n              >\n                <div className=\"w-14 h-14 rounded-full bg-stone-100 border border-stone-200/60 flex items-center justify-center mb-6\">\n                  <PenLine className=\"w-6 h-6 text-stone-500\" />\n                </div>\n                <h3 className=\"font-serif text-xl font-semibold text-stone-800 mb-2\">Your Journal Canvas is Empty</h3>\n                <p className=\"text-sm text-stone-500 leading-relaxed mb-6\">\n                  Take a quiet breath and start writing. Choose from your history feed or create a fresh entry instantly.\n                </p>\n                <button\n                  onClick={handleCreateEntry}\n                  className=\"px-6 py-2.5 bg-stone-950 hover:bg-stone-800 text-white rounded-md text-xs font-semibold tracking-wide flex items-center gap-2 transition-colors cursor-pointer shadow-sm\"\n                >\n                  <Plus className=\"w-4 h-4\" />\n                  Begin Fresh Writing\n                </button>\n              </motion.div>\n            </div>\n          )}\n        </div>\n      </main>\n\n      {/* 3. Right Sidebar - AI Cognitive Reflection Panel */}\n      <AnimatePresence>\n        {activeEntry && isRightPanelOpen && !isFocusMode && (\n          <motion.aside\n            initial={{ width: 0, opacity: 0 }}\n            animate={{ width: 384, opacity: 1 }}\n            exit={{ width: 0, opacity: 0 }}\n            transition={{ type: \"spring\", damping: 25, stiffness: 180 }}\n            className=\"hidden lg:flex flex-col border-l border-stone-200/70 bg-[#FAF9F6] shrink-0 overflow-hidden\"\n          >\n            {/* Panel Header */}\n            <div className=\"p-4 border-b border-stone-200/50 flex items-center justify-between bg-[#FAF9F6]\">\n              <div className=\"flex items-center gap-1.5\">\n                <Sparkles className=\"w-4 h-4 text-stone-700 animate-pulse\" />\n                <span className=\"text-xs font-semibold tracking-wider text-stone-800 uppercase\">Gemini Reflections</span>\n              </div>\n              <button\n                onClick={() => setIsRightPanelOpen(false)}\n                className=\"p-1 text-stone-400 hover:text-stone-700 hover:bg-stone-100 rounded-full\"\n                title=\"Hide reflections panel\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            {/* Inner scrollable reflection contents */}\n            <div className=\"flex-1 overflow-y-auto p-4 space-y-5 min-h-0\">\n              {isAnalyzing ? (\n                <div className=\"py-20 flex flex-col items-center justify-center text-stone-400 text-center\">\n                  <Loader2 className=\"w-8 h-8 animate-spin text-stone-500 mb-4\" />\n                  <p className=\"text-xs font-medium font-sans\">Organizing and synthesizing thoughts...</p>\n                  <p className=\"text-[10px] opacity-70 mt-1 max-w-xs px-6 font-sans\">Tracing themes, drafting self-reflection prompts, and searching for connections across memories.</p>\n                </div>\n              ) : activeEntry.summary ? (\n                <div className=\"space-y-5 animate-fade-in\">\n                  {/* Evocative Title block */}\n                  <div className=\"p-4 bg-white border border-stone-200/80 rounded-xl\">\n                    <h4 className=\"text-[9px] font-bold text-stone-400 uppercase tracking-widest mb-1.5\">Evocative Essence</h4>\n                    <p className=\"text-sm text-stone-800 font-serif font-semibold leading-relaxed\">\n                      \"{activeEntry.summary.title}\"\n                    </p>\n                  </div>\n\n                  {/* Suggested memory block if staged */}\n                  {memories.some((m) => m.sourceEntryId === activeEntry.id && m.status === \"suggested\") && (\n                    <div className=\"p-4 bg-[#FFFDF5] border border-[#FBEFC7] rounded-xl relative overflow-hidden\">\n                      <div className=\"absolute top-0 left-0 w-1 h-full bg-amber-400\" />\n                      <h4 className=\"text-[9px] font-bold text-amber-700 uppercase tracking-widest mb-1\">Staged Memory Suggestion</h4>\n                      {memories\n                        .filter((m) => m.sourceEntryId === activeEntry.id && m.status === \"suggested\")\n                        .map((mem) => (\n                          <div key={mem.id} className=\"flex flex-col gap-3 mt-1.5\">\n                            <p className=\"text-xs text-stone-700 font-serif leading-relaxed italic\">\n                              \"{mem.content}\"\n                            </p>\n                            <div className=\"flex gap-2 justify-end pt-1\">\n                              <button\n                                onClick={() => dismissMemorySuggestion(mem.id)}\n                                className=\"px-2.5 py-1 text-[10px] font-medium text-stone-400 hover:text-stone-700 hover:bg-stone-100 rounded\"\n                              >\n                                Dismiss\n                              </button>\n                              <button\n                                onClick={() => approveMemory(mem.content, activeEntry.id)}\n                                className=\"px-3 py-1 bg-stone-900 hover:bg-stone-800 text-white rounded text-[10px] font-medium flex items-center gap-1 cursor-pointer\"\n                              >\n                                <Check className=\"w-3 h-3\" /> Approve memory\n                              </button>\n                            </div>\n                          </div>\n                        ))}\n                    </div>\n                  )}\n\n                  {/* Key thoughts */}\n                  {activeEntry.summary.keyThoughts?.length > 0 && (\n                    <div>\n                      <h4 className=\"text-[9px] font-bold text-stone-400 uppercase tracking-wider mb-2\">Key Core Thoughts</h4>\n                      <ul className=\"space-y-2\">\n                        {activeEntry.summary.keyThoughts.map((thought, idx) => (\n                          <li key={idx} className=\"p-3 bg-white border border-stone-200/50 rounded-lg text-xs leading-relaxed text-stone-700 font-serif\">\n                            {thought}\n                          </li>\n                        ))}\n                      </ul>\n                    </div>\n                  )}\n\n                  {/* Themes identified */}\n                  {activeEntry.summary.themes?.length > 0 && (\n                    <div>\n                      <h4 className=\"text-[9px] font-bold text-stone-400 uppercase tracking-wider mb-2\">Identified Themes</h4>\n                      <div className=\"flex flex-wrap gap-1.5\">\n                        {activeEntry.summary.themes.map((theme, idx) => (\n                          <span key={idx} className=\"text-[10px] px-2.5 py-1 bg-stone-100 border border-stone-200/40 text-stone-600 rounded-full font-medium\">\n                            {theme}\n                          </span>\n                        ))}\n                      </div>\n                    </div>\n                  )}\n\n                  {/* Decisions highlighted */}\n                  {activeEntry.summary.decisions?.length > 0 && (\n                    <div>\n                      <h4 className=\"text-[9px] font-bold text-stone-400 uppercase tracking-wider mb-2\">Highlighted Decisions</h4>\n                      <ul className=\"space-y-2\">\n                        {activeEntry.summary.decisions.map((dec, idx) => (\n                          <li key={idx} className=\"p-3 bg-white border border-stone-200/50 rounded-lg text-xs leading-relaxed text-stone-700 flex gap-2\">\n                            <span className=\"text-amber-500 font-medium\">\342\234\246</span>\n                            <span>{dec}</span>\n                          </li>\n                        ))}\n                      </ul>\n                    </div>\n                  )}\n\n                  {/* Reflective Questions */}\n                  {activeEntry.summary.questions?.length > 0 && (\n                    <div>\n                      <h4 className=\"text-[9px] font-bold text-stone-400 uppercase tracking-wider mb-2\">Gentle Reflection Prompts</h4>\n                      <div className=\"space-y-2\">\n                        {activeEntry.summary.questions.map((q, idx) => (\n                          <div \n                            key={idx}\n                            onClick={() => {\n                              setChatMessage(`Let\'s talk about this prompt: \"${q}\"`);\n                            }}\n                            className=\"p-3 bg-white hover:bg-stone-50 border border-stone-200/70 hover:border-stone-400/80 rounded-lg text-xs leading-relaxed text-stone-600 font-serif cursor-pointer transition-all flex items-center justify-between\"\n                            title=\"Discuss this prompt in the chat\"\n                          >\n                            <span>\"{q}\"</span>\n                            <ChevronRight className=\"w-3 h-3 text-stone-400 shrink-0 ml-1.5\" />\n                          </div>\n                        ))}\n                      </div>\n                    </div>\n                  )}\n\n                  {/* Next Practical Steps */}\n                  {activeEntry.summary.nextSteps?.length > 0 && (\n                    <div>\n                      <h4 className=\"text-[9px] font-bold text-stone-400 uppercase tracking-wider mb-2\">Next Practical Steps</h4>\n                      <ul className=\"space-y-2 pl-1\">\n                        {activeEntry.summary.nextSteps.map((step, idx) => (\n                          <li key={idx} className=\"text-xs leading-relaxed text-stone-600 flex gap-2.5 items-start\">\n                            <div className=\"w-4 h-4 rounded-full bg-stone-100 flex items-center justify-center shrink-0 border border-stone-200 mt-0.5 text-[10px] font-bold text-stone-500\">{idx+1}</div>\n                            <span>{step}</span>\n                          </li>\n                        ))}\n                      </ul>\n                    </div>\n                  )}\n\n                  {/* Long-Term Connections */}\n                  {activeEntry.summary.connections && activeEntry.summary.connections.length > 0 && (\n                    <div>\n                      <h4 className=\"text-[9px] font-bold text-stone-400 uppercase tracking-wider mb-2\">Traced Connections</h4>\n                      <div className=\"space-y-2\">\n                        {activeEntry.summary.connections.map((conn, idx) => {\n                          const connectedDoc = entries.find((e) => e.id === conn.id);\n                          return (\n                            <div \n                              key={idx}\n                              onClick={() => {\n                                if (connectedDoc) {\n                                  setActiveEntry(connectedDoc);\n                                }\n                              }}\n                              className=\"p-3 bg-stone-50 border border-stone-200/80 hover:border-stone-400 rounded-lg text-left transition-all cursor-pointer\"\n                            >\n                              <div className=\"flex items-center justify-between gap-2 mb-1\">\n                                <span className=\"text-[10px] font-semibold font-serif text-stone-800\">\n                                  {connectedDoc ? connectedDoc.title : \"Older Reflection\"}\n                                </span>\n                                {connectedDoc && (\n                                  <span className=\"text-[8px] text-stone-400 font-medium\">\n                                    {new Date(connectedDoc.createdAt).toLocaleDateString()}\n                                  </span>\n                                )}\n                              </div>\n                              <p className=\"text-[11px] text-stone-500 leading-relaxed font-serif\">\n                                {conn.reason}\n                              </p>\n                            </div>\n                          );\n                        })}\n                      </div>\n                    </div>\n                  )}\n                </div>\n              ) : (\n                <div className=\"py-16 text-center text-stone-400 px-6\">\n                  <Brain className=\"w-7 h-7 mx-auto mb-3 opacity-30 text-stone-500\" />\n                  <h4 className=\"text-xs font-semibold text-stone-700 mb-1\">Intellectual Companion Space</h4>\n                  <p className=\"text-[11px] text-stone-500 leading-relaxed mb-4\">\n                    Once you\'ve finished writing your reflection, click the **\"Make sense of this\"** button to let Gemini structure, theme, and analyze your thoughts.\n                  </p>\n                  {activeEntry.content.trim() && (\n                    <button\n                      onClick={analyzeActiveEntry}\n                      className=\"px-5 py-2 border border-stone-200 hover:bg-stone-100 rounded text-xs font-semibold text-stone-700 transition-colors inline-flex items-center gap-1.5 cursor-pointer\"\n                    >\n                      <Sparkles className=\"w-3.5 h-3.5 text-stone-500 animate-pulse\" />\n                      Reflect on this entry\n                    </button>\n                  )}\n                </div>\n              )}\n\n              {/* Multi-turn Dialogue Panel */}\n              {activeEntry.summary && (\n                <div className=\"pt-4 border-t border-stone-200/60 flex flex-col min-h-[300px]\">\n                  <div className=\"flex items-center gap-1 mb-2\">\n                    <MessageSquare className=\"w-3.5 h-3.5 text-stone-500\" />\n                    <span className=\"text-[10px] font-bold text-stone-400 uppercase tracking-wider\">Unpack Together</span>\n                  </div>\n\n                  {/* Scrollable bubbles list */}\n                  <div className=\"flex-1 space-y-3 pr-1 overflow-y-auto max-h-[250px] min-h-0 bg-stone-100/30 p-2.5 rounded-lg border border-stone-200/20\">\n                    <div className=\"text-[10px] leading-relaxed text-stone-400 font-serif italic text-center pb-2 border-b border-stone-100\">\n                      Companion: Let\'s discuss this entry. Feel free to ask details, ask how to move forward, or explore connections.\n                    </div>\n\n                    {activeEntry.chatHistory?.map((msg, i) => (\n                      <div \n                        key={i} \n                        className={`flex flex-col gap-1 max-w-[85%] ${\n                          msg.role === \"user\" ? \"ml-auto items-end\" : \"mr-auto items-start\"\n                        }`}\n                      >\n                        <div className={`p-2.5 rounded-lg text-xs leading-relaxed font-serif ${\n                          msg.role === \"user\" \n                            ? \"bg-stone-900 text-[#FAF9F6] rounded-br-none shadow-sm\" \n                            : \"bg-white border border-stone-200/80 text-stone-700 rounded-bl-none shadow-[0_1px_2px_rgba(0,0,0,0.02)]\"\n                        }`}>\n                          {msg.text}\n                        </div>\n                        <span className=\"text-[8px] text-stone-400 px-1 font-sans\">\n                          {new Date(msg.timestamp).toLocaleTimeString(undefined, { hour: \"2-digit\", minute: \"2-digit\" })}\n                        </span>\n                      </div>\n                    ))}\n\n                    {isChatting && (\n                      <div className=\"flex items-center gap-1.5 text-stone-400 text-xs py-1\">\n                        <Loader2 className=\"w-3.5 h-3.5 animate-spin\" />\n                        <span className=\"font-serif italic\">Companion is writing...</span>\n                      </div>\n                    )}\n                    <div ref={chatEndRef} />\n                  </div>\n\n                  {/* Input form */}\n                  <form onSubmit={handleSendMessage} className=\"flex gap-1.5 mt-3 shrink-0\">\n                    <input\n                      type=\"text\"\n                      placeholder=\"Discuss or ask clarifying questions...\"\n                      value={chatMessage}\n                      onChange={(e) => setChatMessage(e.target.value)}\n                      disabled={isChatting}\n                      className=\"flex-1 bg-white border border-stone-200 hover:border-stone-300 focus:border-stone-400 outline-none rounded px-3 py-2 text-xs leading-relaxed text-stone-800 transition-all placeholder-stone-300\"\n                    />\n                    <button\n                      type=\"submit\"\n                      disabled={isChatting || !chatMessage.trim()}\n                      className=\"p-2 bg-stone-950 hover:bg-stone-800 disabled:bg-stone-100 text-[#FAF9F6] disabled:text-stone-300 rounded shrink-0 transition-colors flex items-center justify-center cursor-pointer\"\n                    >\n                      <Send className=\"w-3.5 h-3.5\" />\n                    </button>\n                  </form>\n                </div>\n              )}\n            </div>\n          </motion.aside>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n}\n"
    }
