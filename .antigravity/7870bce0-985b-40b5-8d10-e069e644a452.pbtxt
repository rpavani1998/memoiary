  file_change {
    absolute_path_uri: "file:///app/page.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "\"use client\";\n\nimport React, { useState, useEffect, useRef } from \"react\";\nimport { useJournal, JournalEntry, UserMemory, SanjayaCard } from \"@/lib/context/JournalContext\";\nimport { \n  motion, \n  AnimatePresence \n} from \"motion/react\";\nimport { \n  Home,\n  BookOpen,\n  Share2,\n  Sparkles,\n  Brain,\n  Trash2,\n  LogOut,\n  Search,\n  Check,\n  X,\n  MessageSquare,\n  Send,\n  Loader2,\n  Maximize2,\n  Minimize2,\n  ChevronRight,\n  Plus,\n  Edit3,\n  Calendar,\n  AlertCircle,\n  HelpCircle,\n  Clock,\n  TrendingUp,\n  Lightbulb,\n  CheckSquare,\n  User,\n  GitBranch,\n  Target,\n  FileText\n} from \"lucide-react\";\n\ntype ActiveTab = \"home\" | \"story\" | \"connections\" | \"discover\";\n\nexport default function Page() {\n  const {\n    user,\n    loading,\n    entries,\n    memories,\n    insights,\n    insightsLoading,\n    activeEntry,\n    isAnalyzing,\n    isChatting,\n    saveError,\n    \n    signIn,\n    logOut,\n    setActiveEntry,\n    createEmptyEntry,\n    saveEntryContent,\n    deleteJournalEntry,\n    analyzeActiveEntry,\n    sendMessageToActiveEntry,\n    fetchInsights,\n    \n    approveMemory,\n    editMemory,\n    deleteMemory,\n    dismissMemorySuggestion\n  } = useJournal();\n\n  const [activeTab, setActiveTab] = useState<ActiveTab>(\"home\");\n  const [searchQuery, setSearchQuery] = useState(\"\");\n  const [editorContent, setEditorContent] = useState(\"\");\n  const [isFocusMode, setIsFocusMode] = useState(false);\n  const [chatMessage, setChatMessage] = useState(\"\");\n  const [editingMemoryId, setEditingMemoryId] = useState<string | null>(null);\n  const [editingMemoryText, setEditingMemoryText] = useState(\"\");\n  const [isRightPanelOpen, setIsRightPanelOpen] = useState(true);\n  const [selectedConnectionNode, setSelectedConnectionNode] = useState<{ id: string; title: string; content: string; type: string } | null>(null);\n\n  const chatEndRef = useRef<HTMLDivElement>(null);\n  const autosaveTimerRef = useRef<NodeJS.Timeout | null>(null);\n\n  // Sync editor content when user switches or loads the active entry\n  useEffect(() => {\n    if (activeEntry) {\n      setEditorContent(activeEntry.content || \"\");\n    } else {\n      setEditorContent(\"\");\n    }\n  }, [activeEntry?.id]);\n\n  // Scroll interactive companion chat to the bottom on new replies\n  useEffect(() => {\n    if (chatEndRef.current) {\n      chatEndRef.current.scrollIntoView({ behavior: \"smooth\" });\n    }\n  }, [activeEntry?.chatHistory?.length, isChatting]);\n\n  // Local debounced autosave (1.2s delay)\n  const handleEditorChange = (e: React.ChangeEvent<HTMLTextAreaElement>) => {\n    const nextContent = e.target.value;\n    setEditorContent(nextContent);\n\n    if (!activeEntry) return;\n\n    if (autosaveTimerRef.current) {\n      clearTimeout(autosaveTimerRef.current);\n    }\n\n    autosaveTimerRef.current = setTimeout(() => {\n      saveEntryContent(activeEntry.id, nextContent);\n    }, 1200);\n  };\n\n  // Clean up timers on unmount\n  useEffect(() => {\n    return () => {\n      if (autosaveTimerRef.current) clearTimeout(autosaveTimerRef.current);\n    };\n  }, []);\n\n  // Filter journal history based on query\n  const filteredEntries = entries.filter((entry) => {\n    const q = searchQuery.toLowerCase().trim();\n    if (!q) return true;\n    return (\n      entry.content.toLowerCase().includes(q) || \n      entry.title.toLowerCase().includes(q)\n    );\n  });\n\n  const handleSendMessage = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!chatMessage.trim() || !activeEntry) return;\n    const msg = chatMessage.trim();\n    setChatMessage(\"\");\n    await sendMessageToActiveEntry(msg);\n  };\n\n  const handleCreateEntry = async () => {\n    const newEntry = await createEmptyEntry();\n    setEditorContent(\"\");\n    setActiveTab(\"home\");\n    setIsFocusMode(false);\n    return newEntry;\n  };\n\n  const handleSelectEntry = (entry: JournalEntry) => {\n    setActiveEntry(entry);\n    setActiveTab(\"home\");\n  };\n\n  // Fetch discoveries when clicking the discover tab\n  useEffect(() => {\n    if (activeTab === \"discover\" && user && !insights && !insightsLoading) {\n      fetchInsights();\n    }\n  }, [activeTab, user, insights, insightsLoading, fetchInsights]);\n\n  // Utility to map SanjayaCard types to appropriate icons\n  const getCardIcon = (type: string) => {\n    switch (type) {\n      case \"Thought\": return <FileText className=\"w-3.5 h-3.5 text-stone-500\" />;\n      case \"Idea\": return <Lightbulb className=\"w-3.5 h-3.5 text-amber-500\" />;\n      case \"Question\": return <HelpCircle className=\"w-3.5 h-3.5 text-indigo-500\" />;\n      case \"Decision\": return <CheckSquare className=\"w-3.5 h-3.5 text-emerald-500\" />;\n      case \"Goal\": return <Target className=\"w-3.5 h-3.5 text-rose-500\" />;\n      case \"Person\": return <User className=\"w-3.5 h-3.5 text-cyan-500\" />;\n      case \"Pattern\": return <GitBranch className=\"w-3.5 h-3.5 text-teal-500\" />;\n      default: return <FileText className=\"w-3.5 h-3.5 text-stone-500\" />;\n    }\n  };\n\n  // Utility to map card types to CSS classes\n  const getCardStyles = (type: string) => {\n    switch (type) {\n      case \"Thought\": return \"bg-stone-50 border-stone-200 text-stone-800\";\n      case \"Idea\": return \"bg-amber-50/50 border-amber-200/80 text-amber-800\";\n      case \"Question\": return \"bg-indigo-50/50 border-indigo-200/80 text-indigo-800\";\n      case \"Decision\": return \"bg-emerald-50/50 border-emerald-200/80 text-emerald-800\";\n      case \"Goal\": return \"bg-rose-50/50 border-rose-200/80 text-rose-800\";\n      case \"Person\": return \"bg-cyan-50/50 border-cyan-200/80 text-cyan-800\";\n      case \"Pattern\": return \"bg-teal-50/50 border-teal-200/80 text-teal-800\";\n      default: return \"bg-stone-50 border-stone-200 text-stone-800\";\n    }\n  };\n\n  // Loader view during loading state\n  if (loading) {\n    return (\n      <div className=\"min-h-screen bg-[#FDFBF9] flex flex-col items-center justify-center p-6 text-stone-800\">\n        <motion.div \n          animate={{ scale: [1, 1.04, 1], opacity: [0.6, 1, 0.6] }}\n          transition={{ repeat: Infinity, duration: 2, ease: \"easeInOut\" }}\n          className=\"flex flex-col items-center\"\n        >\n          <div className=\"w-12 h-12 rounded-full bg-stone-100 flex items-center justify-center mb-4 border border-stone-200\">\n            <Brain className=\"w-5 h-5 text-stone-600 animate-pulse\" />\n          </div>\n          <p className=\"text-xs font-sans tracking-widest text-stone-400 uppercase\">Consulting Sanjaya...</p>\n        </motion.div>\n      </div>\n    );\n  }\n\n  // Login view\n  if (!user) {\n    return (\n      <div className=\"min-h-screen bg-[#FDFBF9] flex flex-col justify-between p-6 md:p-12 text-stone-800 selection:bg-stone-100\">\n        <header className=\"max-w-7xl mx-auto w-full flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <Brain className=\"w-5 h-5 text-stone-700\" />\n            <span className=\"font-sans text-sm tracking-wider font-semibold text-stone-800\">SANJAYA</span>\n          </div>\n          <div className=\"text-xs text-stone-400 font-sans tracking-wide\">PRIVATE JOURNAL & WITNESS</div>\n        </header>\n\n        <main className=\"max-w-2xl mx-auto w-full flex flex-col items-center text-center my-12\">\n          <motion.div\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 1, ease: [0.16, 1, 0.3, 1] }}\n            className=\"flex flex-col items-center\"\n          >\n            <div className=\"h-10 px-4 py-1 rounded-full bg-stone-100 border border-stone-200/60 flex items-center gap-2 mb-8\">\n              <Sparkles className=\"w-3.5 h-3.5 text-stone-500 animate-pulse\" />\n              <span className=\"text-xs font-sans tracking-wide text-stone-600 font-medium\">\342\200\234You live the story. Sanjaya helps you see it.\342\200\235</span>\n            </div>\n\n            <h1 className=\"font-serif text-4xl sm:text-5xl md:text-6xl text-stone-900 leading-tight tracking-tight mb-6 max-w-xl\">\n              Observe Your Life Over Time\n            </h1>\n\n            <p className=\"font-sans text-stone-600 text-base md:text-lg leading-relaxed mb-10 max-w-lg\">\n              Sanjaya acts as a quiet witness to your story, not an authority over it. Write freely, structure your thoughts into lightweight memory cards, and discover connections across time.\n            </p>\n\n            <motion.button\n              whileHover={{ scale: 1.01 }}\n              whileTap={{ scale: 0.99 }}\n              onClick={signIn}\n              id=\"google-signin-btn\"\n              className=\"px-8 py-3.5 bg-stone-900 hover:bg-stone-800 text-[#FAF9F6] font-sans text-sm font-medium rounded-full shadow-sm flex items-center gap-3 transition-colors cursor-pointer\"\n            >\n              <svg className=\"w-4 h-4 fill-current\" viewBox=\"0 0 24 24\">\n                <path d=\"M12.24 10.285V13.4h6.887C18.2 15.614 15.645 18 12.24 18c-3.86 0-7-3.14-7-7s3.14-7 7-7c1.7 0 3.25.61 4.45 1.615l2.4-2.4C17.3 1.63 14.93 1 12.24 1 6.59 1 2 5.59 2 11.24s4.59 10.24 10.24 10.24c5.9 0 9.81-4.15 9.81-10 0-.67-.06-1.18-.18-1.7H12.24z\"/>\n              </svg>\n              Enter as Writer\n            </motion.button>\n\n            <div className=\"mt-12 flex items-center gap-8 text-xs text-stone-400 font-sans tracking-wide border-t border-stone-200/50 pt-8 w-full justify-center\">\n              <div className=\"flex items-center gap-1.5\">\n                <Check className=\"w-3.5 h-3.5 text-stone-500\" />\n                Isolated User Space\n              </div>\n              <div className=\"flex items-center gap-1.5\">\n                <Check className=\"w-3.5 h-3.5 text-stone-500\" />\n                Objective Witness Persona\n              </div>\n            </div>\n          </motion.div>\n        </main>\n\n        <footer className=\"max-w-7xl mx-auto w-full text-center text-xs text-stone-400 font-sans tracking-wider py-4\">\n          \302\251 {new Date().getFullYear()} Sanjaya Companion. All thoughts private.\n        </footer>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-[#FAF9F6] flex text-stone-800 selection:bg-stone-100 overflow-hidden font-sans\">\n      \n      {/* 1. MAIN NAVIGATION SIDEBAR */}\n      <AnimatePresence>\n        {!isFocusMode && (\n          <motion.aside\n            initial={{ width: 0, opacity: 0 }}\n            animate={{ width: 280, opacity: 1 }}\n            exit={{ width: 0, opacity: 0 }}\n            transition={{ type: \"spring\", damping: 25, stiffness: 180 }}\n            className=\"hidden md:flex flex-col border-r border-stone-200/60 bg-[#FAF9F6] shrink-0 overflow-hidden\"\n          >\n            {/* Logo and Tagline */}\n            <div className=\"p-5 flex flex-col border-b border-stone-200/40\">\n              <div className=\"flex items-center justify-between mb-2\">\n                <div className=\"flex items-center gap-2\">\n                  <Brain className=\"w-4 h-4 text-stone-800\" />\n                  <span className=\"text-sm font-bold tracking-widest text-stone-900\">SANJAYA</span>\n                </div>\n                <button \n                  onClick={logOut}\n                  title=\"Sign Out\"\n                  className=\"p-1 hover:bg-stone-100 rounded-full text-stone-400 hover:text-stone-800 transition-colors cursor-pointer\"\n                >\n                  <LogOut className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n              <p className=\"text-[10px] italic text-stone-400 leading-relaxed\">\n                \342\200\234You live the story. Sanjaya helps you see it.\342\200\235\n              </p>\n\n              {/* User Identity Info */}\n              <div className=\"flex items-center gap-2.5 py-2 mt-4 bg-stone-100/40 px-3 rounded-lg border border-stone-200/20\">\n                {user.photoURL ? (\n                  <img src={user.photoURL} alt={user.displayName || \"User\"} referrerPolicy=\"no-referrer\" className=\"w-6 h-6 rounded-full border border-stone-200\" />\n                ) : (\n                  <div className=\"w-6 h-6 rounded-full bg-stone-200 flex items-center justify-center text-stone-600 font-medium text-xs\">\n                    {user.displayName?.[0] || user.email?.[0] || \"W\"}\n                  </div>\n                )}\n                <div className=\"flex flex-col min-w-0\">\n                  <span className=\"text-[11px] font-semibold text-stone-800 truncate\">{user.displayName || \"Writer\"}</span>\n                  <span className=\"text-[9px] text-stone-400 truncate\">{user.email}</span>\n                </div>\n              </div>\n            </div>\n\n            {/* Vertically Styled Navigation tabs */}\n            <div className=\"p-4 flex flex-col gap-1.5 flex-1 overflow-y-auto\">\n              <button\n                onClick={() => setActiveTab(\"home\")}\n                className={`flex items-center gap-2.5 px-3.5 py-2.5 text-xs font-semibold rounded-lg transition-all text-left cursor-pointer ${\n                  activeTab === \"home\"\n                    ? \"bg-stone-900 text-white shadow-sm\"\n                    : \"text-stone-600 hover:bg-stone-100 hover:text-stone-900\"\n                }`}\n              >\n                <Home className=\"w-4 h-4\" />\n                Today&apos;s Canvas\n              </button>\n\n              <button\n                onClick={() => setActiveTab(\"story\")}\n                className={`flex items-center gap-2.5 px-3.5 py-2.5 text-xs font-semibold rounded-lg transition-all text-left cursor-pointer ${\n                  activeTab === \"story\"\n                    ? \"bg-stone-900 text-white shadow-sm\"\n                    : \"text-stone-600 hover:bg-stone-100 hover:text-stone-900\"\n                }`}\n              >\n                <BookOpen className=\"w-4 h-4\" />\n                My Story\n              </button>\n\n              <button\n                onClick={() => setActiveTab(\"connections\")}\n                className={`flex items-center gap-2.5 px-3.5 py-2.5 text-xs font-semibold rounded-lg transition-all text-left cursor-pointer ${\n                  activeTab === \"connections\"\n                    ? \"bg-stone-900 text-white shadow-sm\"\n                    : \"text-stone-600 hover:bg-stone-100 hover:text-stone-900\"\n                }`}\n              >\n                <Share2 className=\"w-4 h-4\" />\n                Connections Map\n              </button>\n\n              <button\n                onClick={() => setActiveTab(\"discover\")}\n                className={`flex items-center gap-2.5 px-3.5 py-2.5 text-xs font-semibold rounded-lg transition-all text-left cursor-pointer ${\n                  activeTab === \"discover\"\n                    ? \"bg-stone-900 text-white shadow-sm\"\n                    : \"text-stone-600 hover:bg-stone-100 hover:text-stone-900\"\n                }`}\n              >\n                <Sparkles className=\"w-4 h-4\" />\n                Discoveries\n              </button>\n\n              <div className=\"border-t border-stone-200/40 my-3 pt-3\">\n                <span className=\"text-[10px] font-bold text-stone-400 tracking-wider uppercase px-3.5 block mb-2\">Memory Records</span>\n                \n                {memories.filter(m => m.status === \"approved\").length === 0 ? (\n                  <span className=\"text-[10px] text-stone-400 italic px-3.5 block\">No registered memories yet.</span>\n                ) : (\n                  <div className=\"flex flex-col gap-1 max-h-[140px] overflow-y-auto px-1\">\n                    {memories.filter(m => m.status === \"approved\").slice(0, 3).map((m) => (\n                      <div key={m.id} className=\"p-2 bg-stone-50 border border-stone-200/50 rounded text-[10px] leading-relaxed text-stone-500 font-serif truncate\" title={m.content}>\n                        &ldquo;{m.content}&rdquo;\n                      </div>\n                    ))}\n                  </div>\n                )}\n              </div>\n            </div>\n          </motion.aside>\n        )}\n      </AnimatePresence>\n\n      {/* 2. MAIN WORKSPACE CONTENT */}\n      <main className=\"flex-1 flex flex-col min-w-0 bg-[#FDFBF9] overflow-hidden relative\">\n        \n        {/* Mobile Header Bar */}\n        <header className=\"h-14 px-6 border-b border-stone-200/30 flex items-center justify-between shrink-0 bg-[#FDFBF9] md:hidden\">\n          <div className=\"flex items-center gap-2\">\n            <Brain className=\"w-4 h-4 text-stone-800\" />\n            <span className=\"text-xs font-bold tracking-widest text-stone-900 uppercase\">Sanjaya</span>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <button \n              onClick={() => setActiveTab(\"home\")}\n              className={`p-2 rounded-lg text-xs ${activeTab === \"home\" ? \"bg-stone-100 text-stone-900\" : \"text-stone-500\"}`}\n              title=\"Canvas\"\n            >\n              <Home className=\"w-3.5 h-3.5\" />\n            </button>\n            <button \n              onClick={() => setActiveTab(\"story\")}\n              className={`p-2 rounded-lg text-xs ${activeTab === \"story\" ? \"bg-stone-100 text-stone-900\" : \"text-stone-500\"}`}\n              title=\"Story\"\n            >\n              <BookOpen className=\"w-3.5 h-3.5\" />\n            </button>\n            <button \n              onClick={() => setActiveTab(\"connections\")}\n              className={`p-2 rounded-lg text-xs ${activeTab === \"connections\" ? \"bg-stone-100 text-stone-900\" : \"text-stone-500\"}`}\n              title=\"Connections\"\n            >\n              <Share2 className=\"w-3.5 h-3.5\" />\n            </button>\n            <button \n              onClick={() => setActiveTab(\"discover\")}\n              className={`p-2 rounded-lg text-xs ${activeTab === \"discover\" ? \"bg-stone-100 text-stone-900\" : \"text-stone-500\"}`}\n              title=\"Discoveries\"\n            >\n              <Sparkles className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        </header>\n\n        {/* ============ TAB: TODAY\'S CANVAS (EDITOR) ============ */}\n        {activeTab === \"home\" && (\n          <div className=\"flex-1 flex flex-col min-h-0\">\n            {/* Top Editor Control Bar */}\n            <div className=\"h-14 px-6 border-b border-stone-200/30 flex items-center justify-between bg-[#FDFBF9] shrink-0\">\n              <div className=\"flex items-center gap-2\">\n                <button\n                  onClick={() => setIsFocusMode(!isFocusMode)}\n                  className=\"p-2 hover:bg-stone-100 rounded-full text-stone-400 hover:text-stone-700 transition-colors hidden md:block cursor-pointer\"\n                  title={isFocusMode ? \"Exit focus mode\" : \"Enter focus mode\"}\n                >\n                  {isFocusMode ? <Minimize2 className=\"w-4 h-4\" /> : <Maximize2 className=\"w-4 h-4\" />}\n                </button>\n                <span className=\"text-[10px] text-stone-400 font-semibold tracking-wider uppercase\">\n                  {activeEntry ? `Editing Draft: ${activeEntry.title || \"Untitled\"}` : \"Thinking Canvas\"}\n                </span>\n              </div>\n\n              <div className=\"flex items-center gap-3\">\n                {saveError && (\n                  <div className=\"flex items-center gap-1.5 px-3 py-1 bg-red-50 border border-red-100 text-red-600 rounded text-[10px] max-w-xs truncate\">\n                    <AlertCircle className=\"w-3 h-3 flex-shrink-0\" />\n                    <span>Sync error: {saveError}</span>\n                  </div>\n                )}\n\n                {activeEntry && editorContent.trim() && (\n                  <button\n                    onClick={analyzeActiveEntry}\n                    disabled={isAnalyzing}\n                    className=\"px-4 py-1.5 bg-stone-900 hover:bg-stone-800 disabled:bg-stone-100 text-[#FAF9F6] disabled:text-stone-400 rounded-full text-xs font-semibold flex items-center gap-1.5 transition-all shadow-sm cursor-pointer\"\n                  >\n                    {isAnalyzing ? (\n                      <>\n                        <Loader2 className=\"w-3.5 h-3.5 animate-spin\" />\n                        Witness Reflecting...\n                      </>\n                    ) : (\n                      <>\n                        <Sparkles className=\"w-3.5 h-3.5 text-stone-300 animate-pulse\" />\n                        Make Sense of This\n                      </>\n                    )}\n                  </button>\n                )}\n\n                {activeEntry && (\n                  <button\n                    onClick={() => setIsRightPanelOpen(!isRightPanelOpen)}\n                    className={`p-2 hover:bg-stone-100 rounded-full transition-colors hidden md:block cursor-pointer ${\n                      isRightPanelOpen ? \"text-stone-800 bg-stone-50\" : \"text-stone-400\"\n                    }`}\n                    title=\"Toggle Companion Insights\"\n                  >\n                    <Brain className=\"w-4 h-4\" />\n                  </button>\n                )}\n              </div>\n            </div>\n\n            {/* Main Editor Textarea View */}\n            <div className=\"flex-1 overflow-y-auto flex justify-center p-6 md:p-12 min-h-0 bg-[#FDFBF9]\">\n              {activeEntry ? (\n                <div className=\"max-w-2xl w-full flex flex-col h-full\">\n                  <div className=\"text-xs text-stone-400 font-sans tracking-wide mb-3 flex items-center gap-1.5\">\n                    <Calendar className=\"w-3.5 h-3.5 text-stone-300\" />\n                    {new Date(activeEntry.createdAt).toLocaleDateString(undefined, { \n                      weekday: \"long\", \n                      year: \"numeric\", \n                      month: \"long\", \n                      day: \"numeric\" \n                    })}\n                  </div>\n\n                  <h2 className=\"font-serif text-2xl md:text-3xl font-semibold text-stone-900 mb-6\">\n                    {activeEntry.title || \"Untitled Reflection\"}\n                  </h2>\n\n                  <textarea\n                    value={editorContent}\n                    onChange={handleEditorChange}\n                    placeholder=\"Capture what is on your mind... thoughts, messy experiences, questions, lingering choices, or raw logs. Once you write, click \'Make Sense of This\' to let Sanjaya extract lightweight memories and map links.\"\n                    className=\"flex-1 w-full font-serif text-stone-800 text-base md:text-lg leading-relaxed placeholder-stone-300 outline-none resize-none bg-transparent min-h-[300px]\"\n                  />\n\n                  <div className=\"flex items-center justify-between border-t border-stone-200/40 pt-4 mt-6 text-stone-400 font-sans text-xs\">\n                    <div className=\"flex items-center gap-2\">\n                      <span>{editorContent.split(/\\s+/).filter(Boolean).length} words</span>\n                      <span>\342\200\242</span>\n                      <span>{editorContent.length} characters</span>\n                    </div>\n                    <span>Autosaved locally & cloud isolated</span>\n                  </div>\n                </div>\n              ) : (\n                <div className=\"max-w-md w-full flex flex-col items-center justify-center text-center p-8 my-auto\">\n                  <motion.div\n                    initial={{ opacity: 0, scale: 0.95 }}\n                    animate={{ opacity: 1, scale: 1 }}\n                    className=\"flex flex-col items-center\"\n                  >\n                    <div className=\"w-14 h-14 rounded-full bg-stone-50 border border-stone-200/60 flex items-center justify-center mb-6 shadow-sm\">\n                      <PenLine className=\"w-5 h-5 text-stone-500\" />\n                    </div>\n                    <h3 className=\"font-serif text-xl font-semibold text-stone-850 mb-2\">Your Mind Space is Spacious</h3>\n                    <p className=\"text-xs text-stone-450 leading-relaxed mb-6\">\n                      What is taking up space in your thoughts? Pour it out onto a quiet canvas, without judgment or filters.\n                    </p>\n                    <button\n                      onClick={handleCreateEntry}\n                      id=\"create-new-entry-btn\"\n                      className=\"px-6 py-2.5 bg-stone-900 hover:bg-stone-800 text-white rounded-md text-xs font-semibold tracking-wide flex items-center gap-2 transition-colors cursor-pointer shadow-sm\"\n                    >\n                      <Plus className=\"w-4 h-4\" />\n                      Begin fresh writing\n                    </button>\n                  </motion.div>\n                </div>\n              )}\n            </div>\n          </div>\n        )}\n\n        {/* ============ TAB: MY STORY (TIMELINE LIST) ============ */}\n        {activeTab === \"story\" && (\n          <div className=\"flex-1 flex flex-col min-h-0 bg-[#FDFBF9] p-6 md:p-10\">\n            <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-stone-200/40 pb-5 mb-6\">\n              <div>\n                <h2 className=\"font-serif text-2xl font-bold text-stone-900\">My Story</h2>\n                <p className=\"text-xs text-stone-500 leading-relaxed\">Your journey mapped chronologically. Review entries and Sanjaya&apos;s cards.</p>\n              </div>\n\n              <div className=\"flex items-center gap-3\">\n                {/* Search Bar */}\n                <div className=\"relative w-64\">\n                  <Search className=\"w-3.5 h-3.5 text-stone-400 absolute left-3 top-3\" />\n                  <input\n                    type=\"text\"\n                    placeholder=\"Search thoughts & keyword threads...\"\n                    value={searchQuery}\n                    onChange={(e) => setSearchQuery(e.target.value)}\n                    className=\"w-full bg-stone-100/80 border border-stone-200/60 focus:bg-white focus:border-stone-400 outline-none text-xs rounded-lg pl-9 pr-8 py-2.5 transition-all text-stone-800\"\n                  />\n                  {searchQuery && (\n                    <button onClick={() => setSearchQuery(\"\")} className=\"absolute right-2.5 top-2.5 p-1 text-stone-400 hover:text-stone-700 rounded-full\">\n                      <X className=\"w-3 h-3\" />\n                    </button>\n                  )}\n                </div>\n\n                <button\n                  onClick={handleCreateEntry}\n                  className=\"px-4 py-2 bg-stone-900 hover:bg-stone-800 text-white rounded-lg text-xs font-medium flex items-center gap-1.5 shadow-sm transition-colors cursor-pointer\"\n                >\n                  <Plus className=\"w-3.5 h-3.5\" /> Write Reflection\n                </button>\n              </div>\n            </div>\n\n            {/* Timeline Area */}\n            <div className=\"flex-1 overflow-y-auto pr-2 space-y-6\">\n              {filteredEntries.length === 0 ? (\n                <div className=\"text-center py-24 text-stone-400 border border-dashed border-stone-200 rounded-xl bg-stone-50/20\">\n                  <BookOpen className=\"w-8 h-8 mx-auto mb-3 opacity-30 text-stone-500\" />\n                  <p className=\"text-sm font-medium\">No chapters written yet.</p>\n                  <p className=\"text-xs opacity-75 mt-1\">Sanjaya will compile your story chronologically as you record reflections.</p>\n                </div>\n              ) : (\n                <div className=\"relative border-l-2 border-stone-200/60 pl-6 ml-4 space-y-8 py-2\">\n                  {filteredEntries.map((entry) => (\n                    <div key={entry.id} className=\"relative group\">\n                      \n                      {/* Timeline dot */}\n                      <div className=\"absolute -left-[31px] top-1.5 w-4 h-4 rounded-full border-2 border-stone-300 bg-white group-hover:border-stone-900 transition-colors\" />\n\n                      <div className=\"bg-white border border-stone-200/60 hover:border-stone-350 rounded-xl p-5 shadow-sm transition-all\">\n                        <div className=\"flex items-center justify-between gap-2 mb-3\">\n                          <span className=\"text-[10px] text-stone-400 font-semibold tracking-wide flex items-center gap-1.5\">\n                            <Clock className=\"w-3.5 h-3.5 text-stone-300\" />\n                            {new Date(entry.createdAt).toLocaleDateString(undefined, { \n                              weekday: \"short\", \n                              month: \"short\", \n                              day: \"numeric\", \n                              year: \"numeric\" \n                            })}\n                          </span>\n\n                          <div className=\"flex items-center gap-2\">\n                            <button\n                              onClick={() => handleSelectEntry(entry)}\n                              className=\"text-[10px] font-semibold text-stone-600 hover:text-stone-900 px-2.5 py-1 rounded bg-stone-100 hover:bg-stone-200/60 transition-colors cursor-pointer\"\n                            >\n                              Explore Draft\n                            </button>\n                            <button\n                              onClick={() => {\n                                if (confirm(\"Delete this reflection forever?\")) {\n                                  deleteJournalEntry(entry.id);\n                                }\n                              }}\n                              className=\"p-1 hover:bg-stone-100 rounded text-stone-400 hover:text-red-500 transition-colors\"\n                              title=\"Delete reflection\"\n                            >\n                              <Trash2 className=\"w-3.5 h-3.5\" />\n                            </button>\n                          </div>\n                        </div>\n\n                        <h3 className=\"font-serif text-lg font-bold text-stone-850 mb-2\">\n                          {entry.title || \"Untitled Reflection\"}\n                        </h3>\n\n                        <p className=\"text-xs text-stone-600 leading-relaxed font-serif mb-4 line-clamp-3\">\n                          {entry.content || \"Empty draft content.\"}\n                        </p>\n\n                        {/* Sanjaya\'s Witness Reflection & Structured Cards */}\n                        {entry.summary ? (\n                          <div className=\"border-t border-stone-100 pt-4 space-y-4\">\n                            <div className=\"p-3 bg-stone-50/80 rounded-lg border border-stone-200/30\">\n                              <h4 className=\"text-[9px] font-bold text-stone-400 uppercase tracking-widest mb-1\">Sanjaya&apos;s Witness Analysis</h4>\n                              <p className=\"text-xs text-stone-700 leading-relaxed font-serif italic\">\n                                &ldquo;{entry.summary.witnessReflection}&rdquo;\n                              </p>\n                            </div>\n\n                            {entry.summary.cards && entry.summary.cards.length > 0 && (\n                              <div>\n                                <h4 className=\"text-[9px] font-bold text-stone-400 uppercase tracking-widest mb-2\">Generated Memory Cards</h4>\n                                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n                                  {entry.summary.cards.map((card) => (\n                                    <div key={card.id} className={`p-3 rounded-lg border text-xs leading-relaxed flex items-start gap-2 ${getCardStyles(card.type)}`}>\n                                      <div className=\"mt-0.5 shrink-0\">{getCardIcon(card.type)}</div>\n                                      <div className=\"flex-1 min-w-0\">\n                                        <div className=\"flex items-center gap-1.5 mb-1\">\n                                          <span className=\"font-semibold text-stone-800 font-serif truncate\">{card.title}</span>\n                                          <span className=\"text-[8px] uppercase tracking-wide font-bold opacity-60\">({card.type})</span>\n                                        </div>\n                                        <p className=\"text-[11px] opacity-90 leading-relaxed font-serif\">{card.content}</p>\n                                      </div>\n                                    </div>\n                                  ))}\n                                </div>\n                              </div>\n                            )}\n                          </div>\n                        ) : (\n                          <div className=\"border-t border-stone-100 pt-3 flex justify-between items-center text-[10px] text-stone-400 font-medium\">\n                            <span>No analytical cards generated yet.</span>\n                            <button\n                              onClick={() => {\n                                handleSelectEntry(entry);\n                                analyzeActiveEntry();\n                              }}\n                              className=\"text-stone-700 hover:underline flex items-center gap-1\"\n                            >\n                              <Sparkles className=\"w-3 h-3 text-stone-500\" /> Let Sanjaya inspect\n                            </button>\n                          </div>\n                        )}\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              )}\n            </div>\n          </div>\n        )}\n\n        {/* ============ TAB: CONNECTIONS MAP ============ */}\n        {activeTab === \"connections\" && (\n          <div className=\"flex-1 flex flex-col min-h-0 bg-[#FDFBF9] p-6 md:p-10 overflow-hidden\">\n            <div className=\"border-b border-stone-200/40 pb-5 mb-6\">\n              <h2 className=\"font-serif text-2xl font-bold text-stone-900\">Connections Map</h2>\n              <p className=\"text-xs text-stone-500 leading-relaxed\">A visual mapping of how your individual journal entries, questions, and memories connect over time.</p>\n            </div>\n\n            {/* Render Map canvas */}\n            {entries.filter(e => e.summary?.connections && e.summary.connections.length > 0).length === 0 ? (\n              <div className=\"flex-1 flex flex-col items-center justify-center text-center p-8 border border-dashed border-stone-200 rounded-xl bg-stone-50/20\">\n                <Share2 className=\"w-10 h-10 text-stone-300 mb-3 animate-pulse\" />\n                <h3 className=\"font-serif text-base font-semibold text-stone-700\">Linking Your Chapters...</h3>\n                <p className=\"text-xs text-stone-500 leading-relaxed max-w-xs mt-1\">\n                  Sanjaya looks for recurring memories, threads, and linkages as you write. Click &ldquo;Make sense of this&rdquo; on entries to register connections!\n                </p>\n                <button\n                  onClick={() => setActiveTab(\"home\")}\n                  className=\"mt-4 px-4 py-2 bg-stone-900 hover:bg-stone-800 text-white rounded text-xs font-semibold cursor-pointer\"\n                >\n                  Write or Reflect Now\n                </button>\n              </div>\n            ) : (\n              <div className=\"flex-1 flex flex-col lg:flex-row gap-6 min-h-0\">\n                {/* SVG Visualizer */}\n                <div className=\"flex-1 bg-white border border-stone-200/60 rounded-xl shadow-sm relative overflow-hidden flex items-center justify-center min-h-[350px]\">\n                  <div className=\"absolute top-3 left-3 bg-stone-100/80 px-2 py-1 rounded text-[9px] font-sans text-stone-500 uppercase tracking-widest border border-stone-200/40\">\n                    Interactive Topology Graph\n                  </div>\n\n                  {/* Responsive SVG */}\n                  <svg className=\"w-full h-full min-h-[300px]\" viewBox=\"0 0 600 400\">\n                    <defs>\n                      <marker id=\"arrow\" viewBox=\"0 0 10 10\" refX=\"24\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\">\n                        <path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"#D6D3D1\" />\n                      </marker>\n                    </defs>\n\n                    {/* Render linking path lines */}\n                    {entries.map((entry, idx) => {\n                      if (!entry.summary?.connections) return null;\n                      \n                      // Calculate source node layout coords based on index\n                      const angle = (idx / entries.length) * 2 * Math.PI;\n                      const sx = 300 + 150 * Math.cos(angle);\n                      const sy = 200 + 110 * Math.sin(angle);\n\n                      return entry.summary.connections.map((conn, cIdx) => {\n                        const targetIdx = entries.findIndex(e => e.id === conn.id);\n                        if (targetIdx === -1) return null;\n\n                        const targetAngle = (targetIdx / entries.length) * 2 * Math.PI;\n                        const tx = 300 + 150 * Math.cos(targetAngle);\n                        const ty = 200 + 110 * Math.sin(targetAngle);\n\n                        return (\n                          <motion.line\n                            key={`${entry.id}-${conn.id}-${cIdx}`}\n                            x1={sx}\n                            y1={sy}\n                            x2={tx}\n                            y2={ty}\n                            stroke=\"#E7E5E4\"\n                            strokeWidth=\"2\"\n                            strokeDasharray=\"4 4\"\n                            markerEnd=\"url(#arrow)\"\n                            initial={{ pathLength: 0 }}\n                            animate={{ pathLength: 1 }}\n                            transition={{ duration: 1.5, delay: idx * 0.1 }}\n                          />\n                        );\n                      });\n                    })}\n\n                    {/* Center Anchor representation */}\n                    <circle cx=\"300\" cy=\"200\" r=\"14\" fill=\"#1C1917\" className=\"animate-pulse\" />\n                    <text x=\"300\" y=\"204\" textAnchor=\"middle\" fill=\"#FAF9F6\" fontSize=\"9\" fontWeight=\"bold\">S</text>\n\n                    {/* Nodes rendering */}\n                    {entries.map((entry, idx) => {\n                      const angle = (idx / entries.length) * 2 * Math.PI;\n                      const nx = 300 + 150 * Math.cos(angle);\n                      const ny = 200 + 110 * Math.sin(angle);\n                      const hasConnections = entry.summary?.connections && entry.summary.connections.length > 0;\n\n                      return (\n                        <g \n                          key={entry.id}\n                          className=\"cursor-pointer group\"\n                          onClick={() => setSelectedConnectionNode({\n                            id: entry.id,\n                            title: entry.title || \"Untitled\",\n                            content: entry.content || \"Empty content\",\n                            type: hasConnections ? \"Linked Entry\" : \"Entry Node\"\n                          })}\n                        >\n                          <circle \n                            cx={nx} \n                            cy={ny} \n                            r={hasConnections ? \"11\" : \"8\"} \n                            fill={hasConnections ? \"#F59E0B\" : \"#A8A29E\"}\n                            className=\"transition-all group-hover:r-14 stroke-2 stroke-white group-hover:stroke-stone-300\"\n                          />\n                          <text \n                            x={nx} \n                            y={ny - 15} \n                            textAnchor=\"middle\" \n                            fill=\"#44403C\" \n                            fontSize=\"8\" \n                            fontWeight=\"bold\"\n                            className=\"bg-white/80 p-0.5 rounded shadow-sm opacity-60 group-hover:opacity-100\"\n                          >\n                            {(entry.title || \"Untitled\").substring(0, 12)}...\n                          </text>\n                        </g>\n                      );\n                    })}\n                  </svg>\n                </div>\n\n                {/* Connection Node Inspector Details Card */}\n                <div className=\"w-full lg:w-80 flex flex-col gap-4\">\n                  <div className=\"bg-white border border-stone-200/60 rounded-xl p-5 shadow-sm\">\n                    <h3 className=\"text-xs font-bold text-stone-400 uppercase tracking-widest mb-3\">Linked Mind Inspector</h3>\n                    \n                    {selectedConnectionNode ? (\n                      <div className=\"space-y-4\">\n                        <div>\n                          <span className=\"text-[8px] bg-stone-100 text-stone-600 px-2 py-0.5 rounded-full font-bold uppercase\">\n                            {selectedConnectionNode.type}\n                          </span>\n                          <h4 className=\"font-serif text-base font-bold text-stone-800 mt-2\">\n                            {selectedConnectionNode.title}\n                          </h4>\n                        </div>\n\n                        <p className=\"text-xs text-stone-500 font-serif leading-relaxed line-clamp-4 bg-stone-50 p-2.5 rounded border border-stone-100\">\n                          &ldquo;{selectedConnectionNode.content}&rdquo;\n                        </p>\n\n                        {/* Render connection reasons specifically linked to this entry */}\n                        {entries.find(e => e.id === selectedConnectionNode.id)?.summary?.connections?.map((conn, idx) => {\n                          const connectedDoc = entries.find((e) => e.id === conn.id);\n                          return (\n                            <div key={idx} className=\"p-3 bg-stone-100/40 rounded border border-stone-200/40 text-[11px]\">\n                              <div className=\"font-semibold text-stone-700 truncate font-serif\">\n                                Connects to: {connectedDoc ? connectedDoc.title : \"Older thought\"}\n                              </div>\n                              <p className=\"text-[10px] text-stone-500 italic mt-1 font-serif\">\n                                &ldquo;{conn.reason}&rdquo;\n                              </p>\n                            </div>\n                          );\n                        })}\n\n                        <button\n                          onClick={() => {\n                            const entry = entries.find(e => e.id === selectedConnectionNode.id);\n                            if (entry) handleSelectEntry(entry);\n                          }}\n                          className=\"w-full py-2 bg-stone-900 hover:bg-stone-800 text-[#FAF9F6] rounded text-xs font-semibold cursor-pointer text-center\"\n                        >\n                          Load active in Canvas\n                        </button>\n                      </div>\n                    ) : (\n                      <div className=\"text-center py-12 text-stone-400 italic text-xs\">\n                        Click on any node in the interactive graph to trace its connections and read the links Sanjaya detected.\n                      </div>\n                    )}\n                  </div>\n                </div>\n              </div>\n            )}\n          </div>\n        )}\n\n        {/* ============ TAB: DISCOVERIES (AGGREGATE REFLECTIONS) ============ */}\n        {activeTab === \"discover\" && (\n          <div className=\"flex-1 flex flex-col min-h-0 bg-[#FDFBF9] p-6 md:p-10 overflow-y-auto\">\n            <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-stone-200/40 pb-5 mb-6\">\n              <div>\n                <h2 className=\"font-serif text-2xl font-bold text-stone-900\">Discoveries</h2>\n                <p className=\"text-xs text-stone-500 leading-relaxed\">Sanjaya&apos;s synthesized observations, recurring long-term pattern metrics, and tailored writing prompts.</p>\n              </div>\n\n              <button\n                onClick={fetchInsights}\n                disabled={insightsLoading}\n                className=\"px-4 py-2 bg-stone-900 hover:bg-stone-800 disabled:bg-stone-100 text-white disabled:text-stone-400 rounded-lg text-xs font-medium flex items-center gap-2 shadow-sm cursor-pointer\"\n              >\n                {insightsLoading ? (\n                  <>\n                    <Loader2 className=\"w-3.5 h-3.5 animate-spin\" /> Synthesizing...\n                  </>\n                ) : (\n                  <>\n                    <Sparkles className=\"w-3.5 h-3.5\" /> Re-Analyze Story\n                  </>\n                )}\n              </button>\n            </div>\n\n            {insightsLoading ? (\n              <div className=\"py-24 text-center text-stone-400 flex flex-col items-center justify-center\">\n                <Loader2 className=\"w-8 h-8 animate-spin text-stone-500 mb-4\" />\n                <p className=\"text-xs font-semibold font-sans text-stone-600\">Consulting chronological entries...</p>\n                <p className=\"text-[11px] opacity-75 mt-1 max-w-sm\">Please wait while Sanjaya studies and aligns your past thoughts into discoveries.</p>\n              </div>\n            ) : insights ? (\n              <div className=\"space-y-8 max-w-4xl\">\n                \n                {/* 1. Overall Story Synthesis Card */}\n                <div className=\"bg-white border border-stone-200/60 rounded-xl p-6 shadow-sm\">\n                  <h4 className=\"text-[10px] font-bold text-stone-400 uppercase tracking-widest mb-3\">The Story So Far</h4>\n                  <p className=\"text-sm md:text-base leading-relaxed text-stone-800 font-serif\">\n                    {insights.overallSummary}\n                  </p>\n                </div>\n\n                {/* 2. Story Progression Stats (Curiosity Metrics) */}\n                <div>\n                  <h4 className=\"text-[10px] font-bold text-stone-400 uppercase tracking-widest mb-3\">Story Progression Indicators</h4>\n                  <div className=\"grid grid-cols-2 md:grid-cols-4 gap-3\">\n                    <div className=\"bg-white border border-stone-200/50 rounded-xl p-4 shadow-sm text-center\">\n                      <TrendingUp className=\"w-4 h-4 mx-auto mb-1.5 text-stone-400\" />\n                      <div className=\"text-2xl font-serif font-bold text-stone-850\">\n                        {insights.storyProgression?.connectionsDiscovered || 0}\n                      </div>\n                      <div className=\"text-[10px] text-stone-500 font-medium tracking-wide uppercase mt-0.5\">Links Traced</div>\n                    </div>\n\n                    <div className=\"bg-white border border-stone-200/50 rounded-xl p-4 shadow-sm text-center\">\n                      <Clock className=\"w-4 h-4 mx-auto mb-1.5 text-stone-400\" />\n                      <div className=\"text-2xl font-serif font-bold text-stone-850\">\n                        {insights.storyProgression?.thoughtsRevisited || 0}\n                      </div>\n                      <div className=\"text-[10px] text-stone-500 font-medium tracking-wide uppercase mt-0.5\">Loops Spotted</div>\n                    </div>\n\n                    <div className=\"bg-white border border-stone-200/50 rounded-xl p-4 shadow-sm text-center\">\n                      <Lightbulb className=\"w-4 h-4 mx-auto mb-1.5 text-stone-400\" />\n                      <div className=\"text-2xl font-serif font-bold text-stone-850\">\n                        {insights.storyProgression?.ideasEvolved || 0}\n                      </div>\n                      <div className=\"text-[10px] text-stone-500 font-medium tracking-wide uppercase mt-0.5\">Ideas Evolved</div>\n                    </div>\n\n                    <div className=\"bg-white border border-stone-200/50 rounded-xl p-4 shadow-sm text-center\">\n                      <CheckSquare className=\"w-4 h-4 mx-auto mb-1.5 text-stone-400\" />\n                      <div className=\"text-2xl font-serif font-bold text-stone-850\">\n                        {insights.storyProgression?.questionsResolved || 0}\n                      </div>\n                      <div className=\"text-[10px] text-stone-500 font-medium tracking-wide uppercase mt-0.5\">Questions Met</div>\n                    </div>\n                  </div>\n                </div>\n\n                {/* 3. Personalized Discoveries observations */}\n                {insights.discoveries && insights.discoveries.length > 0 && (\n                  <div>\n                    <h4 className=\"text-[10px] font-bold text-stone-400 uppercase tracking-widest mb-3\">Quiet Discoveries</h4>\n                    <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                      {insights.discoveries.map((disc, idx) => (\n                        <div key={idx} className=\"bg-white border border-stone-200/60 rounded-xl p-5 shadow-sm relative overflow-hidden\">\n                          <div className={`absolute top-0 left-0 w-1 h-full ${\n                            disc.type === \"recurrence\" ? \"bg-amber-400\" :\n                            disc.type === \"shift\" ? \"bg-indigo-400\" :\n                            disc.type === \"connection\" ? \"bg-teal-400\" : \"bg-rose-400\"\n                          }`} />\n                          <div className=\"flex items-center gap-1.5 mb-2\">\n                            <span className=\"text-[9px] font-bold uppercase tracking-widest text-stone-400\">\n                              Observation ({disc.type})\n                            </span>\n                          </div>\n                          <p className=\"text-xs font-serif font-bold text-stone-800 leading-relaxed mb-2\">\n                            &ldquo;{disc.text}&rdquo;\n                          </p>\n                          <p className=\"text-[11px] text-stone-500 leading-relaxed font-serif\">\n                            Evidence: {disc.evidence}\n                          </p>\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n                )}\n\n                {/* 4. Long Term Themes */}\n                {insights.keyThemes && insights.keyThemes.length > 0 && (\n                  <div>\n                    <h4 className=\"text-[10px] font-bold text-stone-400 uppercase tracking-widest mb-3\">Evolving Life Themes</h4>\n                    <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3\">\n                      {insights.keyThemes.map((theme, i) => (\n                        <div key={i} className=\"p-4 bg-white border border-stone-200/50 rounded-xl shadow-sm\">\n                          <div className=\"flex justify-between items-center mb-1.5\">\n                            <span className=\"text-xs font-bold text-stone-800 font-serif\">{theme.name}</span>\n                            <span className=\"text-[9px] font-sans px-1.5 py-0.5 bg-stone-100 rounded text-stone-500 font-semibold\">\n                              {theme.count} times\n                            </span>\n                          </div>\n                          <p className=\"text-[11px] text-stone-500 leading-relaxed font-serif\">\n                            {theme.description}\n                          </p>\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n                )}\n\n                {/* 5. Custom Suggested Prompts */}\n                {insights.gentleInspirations && insights.gentleInspirations.length > 0 && (\n                  <div className=\"pt-4 border-t border-stone-200/40\">\n                    <h4 className=\"text-[10px] font-bold text-stone-400 uppercase tracking-widest mb-3\">Quiet Prompts Tailored to Your Story</h4>\n                    <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n                      {insights.gentleInspirations.map((pText, i) => (\n                        <div \n                          key={i}\n                          onClick={() => {\n                            handleCreateEntry().then(newEntry => {\n                              saveEntryContent(newEntry.id, `Reflection Prompt: ${pText}\\n\\n`);\n                            });\n                          }}\n                          className=\"p-4 bg-stone-50 hover:bg-stone-100/50 border border-stone-200/50 hover:border-stone-300 rounded-xl transition-all cursor-pointer text-xs font-serif text-stone-600 leading-relaxed hover:text-stone-850 shadow-sm\"\n                        >\n                          <div className=\"flex items-center justify-between gap-1 mb-2\">\n                            <span className=\"text-[8px] font-bold text-stone-400 uppercase tracking-wider\">Suggested Inspiration</span>\n                            <ChevronRight className=\"w-3 h-3 text-stone-300\" />\n                          </div>\n                          {pText}\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n                )}\n              </div>\n            ) : (\n              <div className=\"text-center py-24 border border-dashed border-stone-200 rounded-xl bg-stone-50/20 max-w-xl\">\n                <Sparkles className=\"w-8 h-8 mx-auto mb-3 opacity-30 text-stone-500 animate-pulse\" />\n                <h3 className=\"font-serif text-base font-semibold text-stone-800\">Your Story Is Compiling</h3>\n                <p className=\"text-xs text-stone-500 leading-relaxed mt-1 px-8\">\n                  Once you capture individual daily chapters, Sanjaya can align them into a deep chronological story and highlight core threads.\n                </p>\n                <button\n                  onClick={fetchInsights}\n                  className=\"mt-4 px-4 py-2 bg-stone-900 hover:bg-stone-800 text-white rounded text-xs font-semibold cursor-pointer\"\n                >\n                  Synthesize Story Discoveries\n                </button>\n              </div>\n            )}\n          </div>\n        )}\n      </main>\n\n      {/* 3. RIGHT SIDEBAR - AI COGNITIVE REFLECTION PANEL & COMPANION CHAT */}\n      <AnimatePresence>\n        {activeTab === \"home\" && activeEntry && isRightPanelOpen && !isFocusMode && (\n          <motion.aside\n            initial={{ width: 0, opacity: 0 }}\n            animate={{ width: 384, opacity: 1 }}\n            exit={{ width: 0, opacity: 0 }}\n            transition={{ type: \"spring\", damping: 25, stiffness: 180 }}\n            className=\"hidden lg:flex flex-col border-l border-stone-200/60 bg-[#FAF9F6] shrink-0 overflow-hidden\"\n          >\n            {/* Panel Header */}\n            <div className=\"p-4 border-b border-stone-200/40 flex items-center justify-between bg-[#FAF9F6]\">\n              <div className=\"flex items-center gap-1.5\">\n                <Sparkles className=\"w-4 h-4 text-stone-700 animate-pulse\" />\n                <span className=\"text-[10px] font-bold tracking-widest text-stone-850 uppercase\">Sanjaya&apos;s Witness Insight</span>\n              </div>\n              <button\n                onClick={() => setIsRightPanelOpen(false)}\n                className=\"p-1 text-stone-400 hover:text-stone-700 hover:bg-stone-100 rounded-full\"\n                title=\"Hide companion panel\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            {/* Inner scrollable contents */}\n            <div className=\"flex-1 overflow-y-auto p-4 space-y-5 min-h-0\">\n              {isAnalyzing ? (\n                <div className=\"py-20 flex flex-col items-center justify-center text-stone-400 text-center\">\n                  <Loader2 className=\"w-8 h-8 animate-spin text-stone-500 mb-4\" />\n                  <p className=\"text-xs font-medium font-sans text-stone-600\">Observing and mapping reflections...</p>\n                  <p className=\"text-[10px] opacity-75 mt-1 max-w-xs px-6 font-sans\">Structuring thoughts, checking background loops, and tracing links back to earlier chapters.</p>\n                </div>\n              ) : activeEntry.summary ? (\n                <div className=\"space-y-5\">\n                  \n                  {/* Witness Narrative Observation */}\n                  <div className=\"p-4 bg-white border border-stone-200/60 rounded-xl shadow-sm\">\n                    <h4 className=\"text-[9px] font-bold text-stone-400 uppercase tracking-widest mb-1.5\">Witness Narrative</h4>\n                    <p className=\"text-xs leading-relaxed text-stone-800 font-serif italic\">\n                      &ldquo;{activeEntry.summary.witnessReflection}&rdquo;\n                    </p>\n                  </div>\n\n                  {/* Suggesed memory block if staged */}\n                  {memories.some((m) => m.sourceEntryId === activeEntry.id && m.status === \"suggested\") && (\n                    <div className=\"p-4 bg-[#FFFDF5] border border-[#FBEFC7] rounded-xl relative overflow-hidden shadow-sm\">\n                      <div className=\"absolute top-0 left-0 w-1 h-full bg-amber-400\" />\n                      <h4 className=\"text-[9px] font-bold text-amber-700 uppercase tracking-widest mb-1\">Staged Memory Suggestion</h4>\n                      {memories\n                        .filter((m) => m.sourceEntryId === activeEntry.id && m.status === \"suggested\")\n                        .map((mem) => (\n                          <div key={mem.id} className=\"flex flex-col gap-3 mt-1.5\">\n                            <p className=\"text-xs text-stone-700 font-serif leading-relaxed italic\">\n                              &ldquo;{mem.content}&rdquo;\n                            </p>\n                            <div className=\"flex gap-2 justify-end pt-1\">\n                              <button\n                                onClick={() => dismissMemorySuggestion(mem.id)}\n                                className=\"px-2.5 py-1 text-[10px] font-medium text-stone-400 hover:text-stone-700 hover:bg-stone-100 rounded\"\n                              >\n                                Dismiss\n                              </button>\n                              <button\n                                onClick={() => approveMemory(mem.content, activeEntry.id)}\n                                className=\"px-3 py-1 bg-stone-900 hover:bg-stone-800 text-white rounded text-[10px] font-medium flex items-center gap-1 cursor-pointer\"\n                              >\n                                <Check className=\"w-3 h-3\" /> Approve memory\n                              </button>\n                            </div>\n                          </div>\n                        ))}\n                    </div>\n                  )}\n\n                  {/* Generated Cards Display */}\n                  {activeEntry.summary.cards && activeEntry.summary.cards.length > 0 && (\n                    <div>\n                      <h4 className=\"text-[9px] font-bold text-stone-400 uppercase tracking-wider mb-2\">Structured Memory Cards</h4>\n                      <div className=\"space-y-2\">\n                        {activeEntry.summary.cards.map((card) => (\n                          <div key={card.id} className={`p-3 rounded-lg border text-xs leading-relaxed flex items-start gap-2 shadow-sm ${getCardStyles(card.type)}`}>\n                            <div className=\"mt-0.5 shrink-0\">{getCardIcon(card.type)}</div>\n                            <div className=\"flex-1 min-w-0\">\n                              <div className=\"flex items-center gap-1.5 mb-0.5\">\n                                <span className=\"font-semibold text-stone-850 font-serif truncate\">{card.title}</span>\n                                <span className=\"text-[8px] uppercase tracking-wide font-bold opacity-60\">({card.type})</span>\n                              </div>\n                              <p className=\"text-[11px] opacity-90 leading-relaxed font-serif\">{card.content}</p>\n                            </div>\n                          </div>\n                        ))}\n                      </div>\n                    </div>\n                  )}\n\n                  {/* Traced chronological connections */}\n                  {activeEntry.summary.connections && activeEntry.summary.connections.length > 0 && (\n                    <div>\n                      <h4 className=\"text-[9px] font-bold text-stone-400 uppercase tracking-wider mb-2\">Traced Story Links</h4>\n                      <div className=\"space-y-2\">\n                        {activeEntry.summary.connections.map((conn, idx) => {\n                          const connectedDoc = entries.find((e) => e.id === conn.id);\n                          return (\n                            <div \n                              key={idx}\n                              onClick={() => {\n                                if (connectedDoc) {\n                                  setActiveEntry(connectedDoc);\n                                }\n                              }}\n                              className=\"p-3 bg-white border border-stone-200/50 hover:border-stone-400 rounded-lg text-left transition-all cursor-pointer shadow-sm\"\n                            >\n                              <div className=\"flex items-center justify-between gap-2 mb-1\">\n                                <span className=\"text-[10px] font-bold font-serif text-stone-850 truncate\">\n                                  {connectedDoc ? connectedDoc.title : \"Older thought chapter\"}\n                                </span>\n                                {connectedDoc && (\n                                  <span className=\"text-[8px] text-stone-400 font-medium\">\n                                    {new Date(connectedDoc.createdAt).toLocaleDateString()}\n                                  </span>\n                                )}\n                              </div>\n                              <p className=\"text-[11px] text-stone-500 leading-relaxed font-serif\">\n                                {conn.reason}\n                              </p>\n                            </div>\n                          );\n                        })}\n                      </div>\n                    </div>\n                  )}\n                </div>\n              ) : (\n                <div className=\"py-16 text-center text-stone-400 px-6\">\n                  <Brain className=\"w-6 h-6 mx-auto mb-3 opacity-30 text-stone-500\" />\n                  <h4 className=\"text-xs font-semibold text-stone-700 mb-1\">Intellectual Witness Space</h4>\n                  <p className=\"text-[11px] text-stone-500 leading-relaxed mb-4\">\n                    Pour out your raw reflections, then click &ldquo;Make sense of this&rdquo; above. Sanjaya will extract structured memory cards and link details back into previous chapters.\n                  </p>\n                </div>\n              )}\n\n              {/* Multi-turn Dialogue Panel */}\n              {activeEntry.summary && (\n                <div className=\"pt-4 border-t border-stone-200/40 flex flex-col min-h-[300px]\">\n                  <div className=\"flex items-center gap-1 mb-2\">\n                    <MessageSquare className=\"w-3.5 h-3.5 text-stone-500\" />\n                    <span className=\"text-[10px] font-bold text-stone-400 uppercase tracking-wider\">Unpack with Sanjaya</span>\n                  </div>\n\n                  {/* Chat logs */}\n                  <div className=\"flex-1 space-y-3 pr-1 overflow-y-auto max-h-[250px] min-h-0 bg-stone-100/30 p-2.5 rounded-lg border border-stone-200/20\">\n                    <div className=\"text-[10px] leading-relaxed text-stone-400 font-serif italic text-center pb-2 border-b border-stone-100\">\n                      I am observing these events with you. Ask questions to compare with past occurrences or unpack decisions.\n                    </div>\n\n                    {activeEntry.chatHistory?.map((msg, i) => (\n                      <div \n                        key={i} \n                        className={`flex flex-col gap-1 max-w-[85%] ${\n                          msg.role === \"user\" ? \"ml-auto items-end\" : \"mr-auto items-start\"\n                        }`}\n                      >\n                        <div className={`p-2.5 rounded-lg text-xs leading-relaxed font-serif ${\n                          msg.role === \"user\" \n                            ? \"bg-stone-900 text-[#FAF9F6] rounded-br-none shadow-sm\" \n                            : \"bg-white border border-stone-200/60 text-stone-700 rounded-bl-none shadow-sm\"\n                        }`}>\n                          {msg.text}\n                        </div>\n                        <span className=\"text-[8px] text-stone-400 px-1 font-sans\">\n                          {new Date(msg.timestamp).toLocaleTimeString(undefined, { hour: \"2-digit\", minute: \"2-digit\" })}\n                        </span>\n                      </div>\n                    ))}\n\n                    {isChatting && (\n                      <div className=\"flex items-center gap-1.5 text-stone-400 text-xs py-1\">\n                        <Loader2 className=\"w-3.5 h-3.5 animate-spin\" />\n                        <span className=\"font-serif italic text-[11px]\">Sanjaya is inspecting...</span>\n                      </div>\n                    )}\n                    <div ref={chatEndRef} />\n                  </div>\n\n                  {/* Chat input form */}\n                  <form onSubmit={handleSendMessage} className=\"flex gap-1.5 mt-3 shrink-0\">\n                    <input\n                      type=\"text\"\n                      placeholder=\"Discuss decisions, recurrence, or detail links...\"\n                      value={chatMessage}\n                      onChange={(e) => setChatMessage(e.target.value)}\n                      disabled={isChatting}\n                      className=\"flex-1 bg-white border border-stone-200 hover:border-stone-300 focus:border-stone-400 outline-none rounded px-3 py-2 text-xs leading-relaxed text-stone-800 transition-all placeholder-stone-300\"\n                    />\n                    <button\n                      type=\"submit\"\n                      disabled={isChatting || !chatMessage.trim()}\n                      className=\"p-2 bg-stone-950 hover:bg-stone-800 disabled:bg-stone-100 text-[#FAF9F6] disabled:text-stone-300 rounded shrink-0 transition-colors flex items-center justify-center cursor-pointer\"\n                    >\n                      <Send className=\"w-3.5 h-3.5\" />\n                    </button>\n                  </form>\n                </div>\n              )}\n            </div>\n          </motion.aside>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n}\n"
    }
