  file_change {
    absolute_path_uri: "file:///lib/context/JournalContext.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "\"use\" client;\n\nimport React, { createContext, useContext, useState, useEffect } from \"react\";\nimport {\n  onAuthStateChanged,\n  signInWithPopup,\n  signOut,\n  User,\n  GoogleAuthProvider\n} from \"firebase/auth\";\nimport {\n  collection,\n  doc,\n  setDoc,\n  updateDoc,\n  deleteDoc,\n  onSnapshot,\n  query,\n  orderBy,\n  getDocs\n} from \"firebase/firestore\";\nimport { auth, db } from \"@/lib/firebase\";\n\n// Clean object helper to strip undefined values to prevent Firestore crashes\nexport function sanitizePayload<T>(obj: T): T {\n  return JSON.parse(JSON.stringify(obj, (key, value) => {\n    return value === undefined ? null : value;\n  }));\n}\n\nexport interface JournalEntry {\n  id: string;\n  content: string;\n  title: string;\n  createdAt: any;\n  updatedAt: any;\n  summary?: {\n    title: string;\n    keyThoughts: string[];\n    themes: string[];\n    questions: string[];\n    ideas: string[];\n    decisions: string[];\n    nextSteps: string[];\n    suggestedMemory?: string | null;\n    connections?: Array<{ id: string; reason: string }>;\n  };\n  chatHistory?: Array<{\n    role: \"user\" | \"model\";\n    text: string;\n    timestamp: number;\n  }>;\n}\n\nexport interface UserMemory {\n  id: string;\n  content: string;\n  createdAt: any;\n  status: \"suggested\" | \"approved\";\n  sourceEntryId?: string;\n}\n\nexport interface JournalInsights {\n  overallSummary: string;\n  keyThemes: Array<{ name: string; description: string; count: number }>;\n  unfinishedThoughts: string[];\n  growthIndicators: string[];\n  gentleInspirations: string[];\n}\n\ninterface JournalContextType {\n  user: User | null;\n  loading: boolean;\n  entries: JournalEntry[];\n  memories: UserMemory[];\n  insights: JournalInsights | null;\n  insightsLoading: boolean;\n  activeEntry: JournalEntry | null;\n  isAnalyzing: boolean;\n  isChatting: boolean;\n  saveError: string | null;\n  \n  signIn: () => Promise<void>;\n  logOut: () => Promise<void>;\n  setActiveEntry: (entry: JournalEntry | null) => void;\n  createEmptyEntry: () => Promise<JournalEntry>;\n  saveEntryContent: (id: string, content: string) => Promise<void>;\n  deleteJournalEntry: (id: string) => Promise<void>;\n  analyzeActiveEntry: () => Promise<void>;\n  sendMessageToActiveEntry: (message: string) => Promise<void>;\n  fetchInsights: () => Promise<void>;\n  \n  approveMemory: (content: string, sourceEntryId?: string) => Promise<void>;\n  editMemory: (id: string, content: string) => Promise<void>;\n  deleteMemory: (id: string) => Promise<void>;\n  dismissMemorySuggestion: (id: string) => Promise<void>;\n}\n\nconst JournalContext = createContext<JournalContextType | undefined>(undefined);\n\nexport function JournalProvider({ children }: { children: React.ReactNode }) {\n  const [user, setUser] = useState<User | null>(null);\n  const [loading, setLoading] = useState<boolean>(true);\n  const [entries, setEntries] = useState<JournalEntry[]>([]);\n  const [memories, setMemories] = useState<UserMemory[]>([]);\n  const [insights, setInsights] = useState<JournalInsights | null>(null);\n  const [insightsLoading, setInsightsLoading] = useState<boolean>(false);\n  const [activeEntry, setActiveEntryState] = useState<JournalEntry | null>(null);\n  \n  const [isAnalyzing, setIsAnalyzing] = useState<boolean>(false);\n  const [isChatting, setIsChatting] = useState<boolean>(false);\n  const [saveError, setSaveError] = useState<string | null>(null);\n\n  // Synchronize activeEntry changes with updating its corresponding list item\n  const setActiveEntry = (entry: JournalEntry | null) => {\n    setActiveEntryState(entry);\n    setSaveError(null);\n  };\n\n  // Google sign in helper\n  const signIn = async () => {\n    try {\n      const provider = new GoogleAuthProvider();\n      provider.setCustomParameters({ prompt: \"select_account\" });\n      await signInWithPopup(auth, provider);\n    } catch (error: any) {\n      console.error(\"Sign-in failed:\", error);\n      setSaveError(`Sign-in failed: ${error?.message || error}`);\n    }\n  };\n\n  // Log out helper\n  const logOut = async () => {\n    try {\n      await signOut(auth);\n      setEntries([]);\n      setMemories([]);\n      setInsights(null);\n      setActiveEntry(null);\n    } catch (error) {\n      console.error(\"Logout failed:\", error);\n    }\n  };\n\n  // Handle Auth state change\n  useEffect(() => {\n    const unsubscribe = onAuthStateChanged(auth, (firebaseUser) => {\n      setUser(firebaseUser);\n      setLoading(false);\n    });\n    return () => unsubscribe();\n  }, []);\n\n  // Listen to entries and memories in real time once user is logged in\n  useEffect(() => {\n    if (!user) return;\n\n    // Real-time journal entries listener\n    const entriesRef = collection(db, \"users\", user.uid, \"entries\");\n    const entriesQuery = query(entriesRef, orderBy(\"createdAt\", \"desc\"));\n    const unsubEntries = onSnapshot(entriesQuery, (snapshot) => {\n      const loadedEntries: JournalEntry[] = [];\n      snapshot.forEach((doc) => {\n        loadedEntries.push({ id: doc.id, ...doc.data() } as JournalEntry);\n      });\n      setEntries(loadedEntries);\n\n      // Keep activeEntry in sync with latest Firestore snapshot\n      setActiveEntryState((prevActive) => {\n        if (!prevActive) return null;\n        const currentDoc = loadedEntries.find((e) => e.id === prevActive.id);\n        return currentDoc || null;\n      });\n    }, (error) => {\n      console.error(\"Error loading entries:\", error);\n      setSaveError(\"Failed to load journal entries from cloud storage.\");\n    });\n\n    // Real-time memories listener\n    const memoriesRef = collection(db, \"users\", user.uid, \"memories\");\n    const memoriesQuery = query(memoriesRef, orderBy(\"createdAt\", \"desc\"));\n    const unsubMemories = onSnapshot(memoriesQuery, (snapshot) => {\n      const loadedMemories: UserMemory[] = [];\n      snapshot.forEach((doc) => {\n        loadedMemories.push({ id: doc.id, ...doc.data() } as UserMemory);\n      });\n      setMemories(loadedMemories);\n    }, (error) => {\n      console.error(\"Error loading memories:\", error);\n    });\n\n    return () => {\n      unsubEntries();\n      unsubMemories();\n    };\n  }, [user]);\n\n  // Create empty journal entry\n  const createEmptyEntry = async () => {\n    if (!user) throw new Error(\"Must be logged in to create entries\");\n    \n    const entriesRef = collection(db, \"users\", user.uid, \"entries\");\n    const newDocRef = doc(entriesRef); // Generates a unique document ID client-side\n    \n    const newEntry: JournalEntry = {\n      id: newDocRef.id,\n      content: \"\",\n      title: \"Untitled Entry\",\n      createdAt: new Date().toISOString(),\n      updatedAt: new Date().toISOString(),\n      chatHistory: []\n    };\n\n    const sanitized = sanitizePayload(newEntry);\n    await setDoc(newDocRef, sanitized);\n    setActiveEntry(newEntry);\n    return newEntry;\n  };\n\n  // Autosave entry content as user writes\n  const saveEntryContent = async (id: string, content: string) => {\n    if (!user) return;\n    try {\n      const entryRef = doc(db, \"users\", user.uid, \"entries\", id);\n      \n      // Extract a quick clean title from the first line or fallback\n      const cleanLine = content.trim().split(\"\\n\")[0] || \"\";\n      const suggestedTitle = cleanLine.length > 35 \n        ? cleanLine.substring(0, 32) + \"...\" \n        : cleanLine || \"Untitled Entry\";\n\n      const updates = {\n        content,\n        title: content.trim() ? suggestedTitle : \"Untitled Entry\",\n        updatedAt: new Date().toISOString()\n      };\n\n      await updateDoc(entryRef, sanitizePayload(updates));\n      setSaveError(null);\n    } catch (error: any) {\n      console.error(\"Autosave error:\", error);\n      setSaveError(\"Autosave failed. Your local edits are safe, but sync is paused.\");\n    }\n  };\n\n  // Delete journal entry\n  const deleteJournalEntry = async (id: string) => {\n    if (!user) return;\n    try {\n      const entryRef = doc(db, \"users\", user.uid, \"entries\", id);\n      await deleteDoc(entryRef);\n      if (activeEntry?.id === id) {\n        setActiveEntry(null);\n      }\n    } catch (error) {\n      console.error(\"Delete failed:\", error);\n      setSaveError(\"Failed to delete entry from database.\");\n    }\n  };\n\n  // Get Auth Token from current user session\n  const getIdToken = async () => {\n    if (!user) return null;\n    return await user.getIdToken();\n  };\n\n  // Analyze the current active entry with Gemini\n  const analyzeActiveEntry = async () => {\n    if (!user || !activeEntry) return;\n    \n    setIsAnalyzing(true);\n    setSaveError(null);\n\n    try {\n      const idToken = await getIdToken();\n      if (!idToken) throw new Error(\"Could not retrieve authorization credentials\");\n\n      // Build short past entries context to prevent exceeding token limits\n      const otherEntries = entries\n        .filter((e) => e.id !== activeEntry.id && e.summary)\n        .slice(0, 15) // Top 15 past analyzed entries for connection detection\n        .map((e) => ({\n          id: e.id,\n          title: e.title,\n          summary: e.summary?.title || e.title,\n          date: e.createdAt\n        }));\n\n      const activeMemories = memories\n        .filter((m) => m.status === \"approved\")\n        .map((m) => m.content);\n\n      const response = await fetch(\"/api/gemini/analyze\", {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          \"Authorization\": `Bearer ${idToken}`\n        },\n        body: JSON.stringify({\n          content: activeEntry.content,\n          pastEntries: otherEntries,\n          memories: activeMemories\n        })\n      });\n\n      if (!response.ok) {\n        const errData = await response.json();\n        throw new Error(errData.error || \"Analysis request failed\");\n      }\n\n      const data = await response.json();\n      \n      // Update entry doc in Firestore with completed analysis details\n      const entryRef = doc(db, \"users\", user.uid, \"entries\", activeEntry.id);\n      \n      const updates = {\n        summary: data.analysis,\n        // Update title with the beautiful evocative AI-suggested title\n        title: data.analysis.title || activeEntry.title,\n        updatedAt: new Date().toISOString()\n      };\n\n      await updateDoc(entryRef, sanitizePayload(updates));\n\n      // If a memory was suggested, stage it in Firestore as \'suggested\' so user can approve it in the UI\n      if (data.analysis.suggestedMemory) {\n        const memoryContent = data.analysis.suggestedMemory;\n        \n        // Double check if a memory with this content already exists or was suggested\n        const alreadyExists = memories.some(\n          (m) => m.content.toLowerCase().trim() === memoryContent.toLowerCase().trim()\n        );\n\n        if (!alreadyExists) {\n          const memoriesRef = collection(db, \"users\", user.uid, \"memories\");\n          const memDocRef = doc(memoriesRef);\n          \n          await setDoc(memDocRef, sanitizePayload({\n            id: memDocRef.id,\n            content: memoryContent,\n            createdAt: new Date().toISOString(),\n            status: \"suggested\",\n            sourceEntryId: activeEntry.id\n          }));\n        }\n      }\n\n    } catch (error: any) {\n      console.error(\"Analysis error:\", error);\n      setSaveError(`Analysis failed: ${error?.message || error}`);\n    } finally {\n      setIsAnalyzing(false);\n    }\n  };\n\n  // Chat conversation inside the active entry\n  const sendMessageToActiveEntry = async (message: string) => {\n    if (!user || !activeEntry) return;\n    \n    setIsChatting(true);\n    setSaveError(null);\n\n    // Optimistically update current client state to maintain responsiveness\n    const timestamp = Date.now();\n    const updatedHistory = [\n      ...(activeEntry.chatHistory || []),\n      { role: \"user\" as const, text: message, timestamp }\n    ];\n\n    const entryRef = doc(db, \"users\", user.uid, \"entries\", activeEntry.id);\n\n    try {\n      // Step 1: Save the user\'s input to the database immediately to satisfy transactional integrity rules\n      await updateDoc(entryRef, sanitizePayload({\n        chatHistory: updatedHistory,\n        updatedAt: new Date().toISOString()\n      }));\n\n      const idToken = await getIdToken();\n      if (!idToken) throw new Error(\"Could not retrieve authentication credentials\");\n\n      // Send chat history and grounding content to API proxy\n      const response = await fetch(\"/api/gemini/chat\", {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          \"Authorization\": `Bearer ${idToken}`\n        },\n        body: JSON.stringify({\n          entryContent: activeEntry.content,\n          chatHistory: (activeEntry.chatHistory || []).map((h) => ({\n            role: h.role,\n            text: h.text\n          })),\n          message\n        })\n      });\n\n      if (!response.ok) {\n        const errData = await response.json();\n        throw new Error(errData.error || \"Chat request failed\");\n      }\n\n      const data = await response.json();\n\n      // Step 2: Persist Gemini\'s response securely\n      const finalHistory = [\n        ...updatedHistory,\n        { role: \"model\" as const, text: data.text, timestamp: Date.now() }\n      ];\n\n      await updateDoc(entryRef, sanitizePayload({\n        chatHistory: finalHistory,\n        updatedAt: new Date().toISOString()\n      }));\n\n    } catch (error: any) {\n      console.error(\"Chat conversation error:\", error);\n      setSaveError(`Chat transaction failed: ${error?.message || error}`);\n      \n      // Rollback optimization if it failed to save to firestore\n      const revertedHistory = activeEntry.chatHistory || [];\n      await updateDoc(entryRef, sanitizePayload({\n        chatHistory: revertedHistory,\n        updatedAt: new Date().toISOString()\n      })).catch(console.error);\n    } finally {\n      setIsChatting(false);\n    }\n  };\n\n  // Fetch / synthesize aggregate insights\n  const fetchInsights = async () => {\n    if (!user) return;\n    \n    setInsightsLoading(true);\n    setSaveError(null);\n\n    try {\n      const idToken = await getIdToken();\n      if (!idToken) throw new Error(\"Authorization token not found\");\n\n      // Send recent entries\n      const analyzedEntries = entries\n        .filter((e) => e.content)\n        .slice(0, 20); // Top 20 entries for deep long-term insight analysis\n\n      const response = await fetch(\"/api/gemini/insights\", {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          \"Authorization\": `Bearer ${idToken}`\n        },\n        body: JSON.stringify({\n          entries: analyzedEntries\n        })\n      });\n\n      if (!response.ok) {\n        throw new Error(\"Failed to compile pattern insights\");\n      }\n\n      const data = await response.json();\n      setInsights(data.insights);\n    } catch (error: any) {\n      console.error(\"Insights generation failed:\", error);\n      setSaveError(`Insights compilation failed: ${error?.message || error}`);\n    } finally {\n      setInsightsLoading(false);\n    }\n  };\n\n  // User Memory management hooks\n  const approveMemory = async (content: string, sourceEntryId?: string) => {\n    if (!user) return;\n    try {\n      // Find the suggested memory matching content\n      const sugMem = memories.find(\n        (m) => m.content.toLowerCase().trim() === content.toLowerCase().trim() && m.status === \"suggested\"\n      );\n\n      if (sugMem) {\n        const memRef = doc(db, \"users\", user.uid, \"memories\", sugMem.id);\n        await updateDoc(memRef, {\n          status: \"approved\",\n          updatedAt: new Date().toISOString()\n        });\n      } else {\n        // Create manual memory\n        const memoriesRef = collection(db, \"users\", user.uid, \"memories\");\n        const memDocRef = doc(memoriesRef);\n        await setDoc(memDocRef, sanitizePayload({\n          id: memDocRef.id,\n          content,\n          createdAt: new Date().toISOString(),\n          status: \"approved\",\n          sourceEntryId: sourceEntryId || null\n        }));\n      }\n    } catch (error) {\n      console.error(\"Memory approval failed:\", error);\n    }\n  };\n\n  const editMemory = async (id: string, content: string) => {\n    if (!user) return;\n    try {\n      const memRef = doc(db, \"users\", user.uid, \"memories\", id);\n      await updateDoc(memRef, {\n        content,\n        updatedAt: new Date().toISOString()\n      });\n    } catch (error) {\n      console.error(\"Editing memory failed:\", error);\n    }\n  };\n\n  const deleteMemory = async (id: string) => {\n    if (!user) return;\n    try {\n      const memRef = doc(db, \"users\", user.uid, \"memories\", id);\n      await deleteDoc(memRef);\n    } catch (error) {\n      console.error(\"Deleting memory failed:\", error);\n    }\n  };\n\n  const dismissMemorySuggestion = async (id: string) => {\n    if (!user) return;\n    try {\n      const memRef = doc(db, \"users\", user.uid, \"memories\", id);\n      await deleteDoc(memRef);\n    } catch (error) {\n      console.error(\"Dismissing memory suggestion failed:\", error);\n    }\n  };\n\n  return (\n    <JournalContext.Provider\n      value={{\n        user,\n        loading,\n        entries,\n        memories,\n        insights,\n        insightsLoading,\n        activeEntry,\n        isAnalyzing,\n        isChatting,\n        saveError,\n        \n        signIn,\n        logOut,\n        setActiveEntry,\n        createEmptyEntry,\n        saveEntryContent,\n        deleteJournalEntry,\n        analyzeActiveEntry,\n        sendMessageToActiveEntry,\n        fetchInsights,\n        \n        approveMemory,\n        editMemory,\n        deleteMemory,\n        dismissMemorySuggestion\n      }}\n    >\n      {children}\n    </JournalContext.Provider>\n  );\n}\n\nexport function useJournal() {\n  const context = useContext(JournalContext);\n  if (context === undefined) {\n    throw new Error(\"useJournal must be used within a JournalProvider\");\n  }\n  return context;\n}\n"
    }
