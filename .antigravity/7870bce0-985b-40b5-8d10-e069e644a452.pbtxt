  file_change {
    absolute_path_uri: "file:///app/api/gemini/analyze/route.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { NextResponse } from \"next/server\";\nimport { verifyUserToken } from \"@/lib/firebase-admin\";\nimport { generateContentWithFallback, safeParseJson } from \"@/lib/gemini\";\n\nexport async function POST(req: Request) {\n  try {\n    // Ensure auth token is verified\n    const decodedToken = await verifyUserToken(req);\n    if (!decodedToken) {\n      return NextResponse.json({ error: \"Unauthorized access\" }, { status: 401 });\n    }\n\n    // Defensive body parsing\n    let body: any = {};\n    try {\n      body = await req.json();\n    } catch {\n      return NextResponse.json({ error: \"Invalid JSON payload\" }, { status: 400 });\n    }\n\n    const { content, pastEntries = [], memories = [] } = body;\n    if (!content || typeof content !== \"string\" || !content.trim()) {\n      return NextResponse.json({ error: \"Content is required and must be a valid string\" }, { status: 400 });\n    }\n\n    // Prepare context about past entries and existing memories to allow the model to discover connections\n    const pastEntriesContext = pastEntries.map((e: any) => ({\n      id: e.id,\n      title: e.title || \"Untitled\",\n      summary: e.summary || \"\",\n      date: e.date || \"Unknown date\"\n    }));\n\n    const memoriesContext = memories.length > 0 \n      ? `Here are some things the user has explicitly asked you to remember about them:\\n${memories.map((m: string) => `- ${m}`).join(\"\\n\")}`\n      : \"The user has no stored memories yet.\";\n\n    const systemInstruction = `You are the gentle, reflecting companion of a private, beautiful thinking space called \"Personal Gemini Journal\". Your primary purpose is to help the user unpack, organize, understand, and connect their thoughts.\n\nYour style is calm, deeply thoughtful, elegant, and non-judgmental. Do not dominate. You are a mirror, not a controller. Do not present assumptions as facts, and never sound preachy or use generic AI buzzwords (e.g. \"supercharge\", \"empower\", \"unlock\").\n\nAnalyze the provided journal entry and return a structured JSON object.\n\nCRITICAL: Return ONLY valid JSON. Your response must be parseable as standard JSON. Do not include extra conversational text outside the JSON object.\n\nThe JSON schema must be:\n{\n  \"title\": \"A short, evocative 3-5 word title for this entry reflecting its essence\",\n  \"keyThoughts\": [\"Bullet points of the underlying or core thoughts the user is processing\"],\n  \"themes\": [\"Recurring themes, emotions, or themes identified (e.g., \'Creative blocks\', \'Winter goals\', \'Unsettled plans\')\"],\n  \"questions\": [\"2-3 reflective, gentle questions that invite self-reflection rather than giving instructions\"],\n  \"ideas\": [\"1-2 reframings or creative possibilities worth considering\"],\n  \"decisions\": [\"Decisions made, in progress, or highlighted in the entry (empty array if none)\"],\n  \"nextSteps\": [\"1-3 gentle, practical, low-pressure steps (empty array if none)\"],\n  \"suggestedMemory\": \"A single declarative statement of a meaningful insight/preference the user might want you to remember (e.g., \'You prefer studying in the early morning\' or \'You are working on a new piano piece\'). Set to null if there is nothing of long-term importance to remember.\",\n  \"connections\": [\n    {\n      \"id\": \"ID of a past entry that is relevantly connected to this new entry\",\n      \"reason\": \"A 1-sentence description of the connection between the current thought and that past entry\"\n    }\n  ]\n}\n\nInstructions for connections:\nLook at the list of past entries below. If the current entry connects, builds on, is a continuation of, or contrasts with any past entries, populate the \"connections\" array. If there are no connections, return an empty array [].\n\n${memoriesContext}`;\n\n    const prompt = `Here is the user\'s journal entry:\n\"\"\"\n${content}\n\"\"\"\n\nHere are the user\'s past journal entries (id, title, summary, date):\n${JSON.stringify(pastEntriesContext, null, 2)}\n\nPlease analyze the entry, identify connections, suggest memories, and return the structured JSON reflection.`;\n\n    const result = await generateContentWithFallback(prompt, {\n      systemInstruction,\n      temperature: 0.2,\n    });\n\n    const fallbackResponse = {\n      title: \"Untitled Reflection\",\n      keyThoughts: [\"Processing thoughts...\"],\n      themes: [\"General reflection\"],\n      questions: [\"What is on your mind?\"],\n      ideas: [\"Take it one step at a time.\"],\n      decisions: [],\n      nextSteps: [],\n      suggestedMemory: null,\n      connections: []\n    };\n\n    const parsedData = safeParseJson(result.text, fallbackResponse);\n\n    return NextResponse.json({\n      analysis: parsedData,\n      modelUsed: result.modelUsed\n    });\n\n  } catch (error: any) {\n    console.error(\"Error in analyze endpoint:\", error);\n    return NextResponse.json({ error: error?.message || \"Internal server error\" }, { status: 500 });\n  }\n}\n"
    }
