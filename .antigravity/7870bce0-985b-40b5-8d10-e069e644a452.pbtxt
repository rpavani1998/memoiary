      replacement_content: "{\n  \"entities\": {\n    \"CaptureSession\": {\n      \"title\": \"CaptureSession\",\n      \"description\": \"Represents an immutable unified capture action containing raw text, voice transcripts, or media evidence.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_-]+$\" },\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"type\": { \"type\": \"string\", \"enum\": [\"text\", \"audio\", \"image\", \"video\", \"multimodal\", \"mixed\"] },\n        \"rawContent\": { \"type\": \"string\", \"maxLength\": 50000 },\n        \"status\": { \"type\": \"string\", \"enum\": [\"pending\", \"processing\", \"completed\", \"failed\"] },\n        \"timezone\": { \"type\": \"string\", \"maxLength\": 64 },\n        \"mediaAssets\": { \"type\": \"array\" },\n        \"extractedSummary\": { \"type\": \"string\", \"maxLength\": 2000 },\n        \"createdAt\": { \"type\": \"string\" },\n        \"updatedAt\": { \"type\": \"string\" }\n      },\n      \"required\": [\"id\", \"userId\", \"type\", \"status\", \"createdAt\"]\n    },\n    \"Episode\": {\n      \"title\": \"Episode\",\n      \"description\": \"The primary autobiographical unit representing an experience, meeting, event, conversation, or milestone.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_-]+$\" },\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"type\": { \"type\": \"string\", \"enum\": [\"meeting\", \"conversation\", \"meal\", \"trip\", \"visit\", \"work\", \"achievement\", \"failure\", \"decision\", \"conflict\", \"celebration\", \"purchase\", \"experience\", \"milestone\", \"other\"] },\n        \"title\": { \"type\": \"string\", \"maxLength\": 256 },\n        \"summary\": { \"type\": \"string\", \"maxLength\": 4000 },\n        \"startTime\": { \"type\": \"string\" },\n        \"endTime\": { \"type\": \"string\" },\n        \"timePrecision\": { \"type\": \"string\", \"enum\": [\"exact_datetime\", \"day\", \"week\", \"month\", \"year\", \"approximate_period\", \"unknown\"] },\n        \"importanceScore\": { \"type\": \"number\" },\n        \"entityIds\": { \"type\": \"array\" },\n        \"sourceCaptureId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"significance\": { \"type\": \"string\", \"maxLength\": 1000 },\n        \"createdAt\": { \"type\": \"string\" },\n        \"updatedAt\": { \"type\": \"string\" }\n      },\n      \"required\": [\"id\", \"userId\", \"type\", \"title\", \"summary\", \"sourceCaptureId\", \"createdAt\"]\n    },\n    \"Entity\": {\n      \"title\": \"Entity\",\n      \"description\": \"Persistent entities in the user\'s world (People, Places, Organizations, Projects, Objects, Topics).\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_-]+$\" },\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"type\": { \"type\": \"string\", \"enum\": [\"PERSON\", \"PLACE\", \"ORGANIZATION\", \"PROJECT\", \"OBJECT\", \"TOPIC\"] },\n        \"canonicalName\": { \"type\": \"string\", \"maxLength\": 256 },\n        \"aliases\": { \"type\": \"array\" },\n        \"description\": { \"type\": \"string\", \"maxLength\": 2000 },\n        \"occupation\": { \"type\": \"string\", \"maxLength\": 256 },\n        \"importanceScore\": { \"type\": \"number\" },\n        \"confidenceScore\": { \"type\": \"number\" },\n        \"status\": { \"type\": \"string\", \"enum\": [\"active\", \"archived\", \"merged\"] },\n        \"createdAt\": { \"type\": \"string\" },\n        \"updatedAt\": { \"type\": \"string\" },\n        \"lastMentionedAt\": { \"type\": \"string\" }\n      },\n      \"required\": [\"id\", \"userId\", \"type\", \"canonicalName\", \"createdAt\"]\n    },\n    \"Relationship\": {\n      \"title\": \"Relationship\",\n      \"description\": \"First-class temporal relationship between entities or between user and an entity.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_-]+$\" },\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"sourceEntityId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"targetEntityId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"relationshipType\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"strength\": { \"type\": \"number\" },\n        \"confidence\": { \"type\": \"number\" },\n        \"status\": { \"type\": \"string\", \"enum\": [\"active\", \"historical\", \"superseded\"] },\n        \"validFrom\": { \"type\": \"string\" },\n        \"validTo\": { \"type\": \"string\" },\n        \"sourceCaptureId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"createdAt\": { \"type\": \"string\" },\n        \"updatedAt\": { \"type\": \"string\" }\n      },\n      \"required\": [\"id\", \"userId\", \"sourceEntityId\", \"targetEntityId\", \"relationshipType\", \"createdAt\"]\n    },\n    \"Emotion\": {\n      \"title\": \"Emotion\",\n      \"description\": \"Attributed emotional observation distinguishing between user emotion and observed emotion of others.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_-]+$\" },\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"episodeId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"subjectEntityId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"targetEntityId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"emotionType\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"intensity\": { \"type\": \"number\" },\n        \"cause\": { \"type\": \"string\", \"maxLength\": 1000 },\n        \"confidence\": { \"type\": \"number\" },\n        \"createdAt\": { \"type\": \"string\" }\n      },\n      \"required\": [\"id\", \"userId\", \"episodeId\", \"subjectEntityId\", \"emotionType\", \"createdAt\"]\n    },\n    \"MemoryState\": {\n      \"title\": \"MemoryState\",\n      \"description\": \"Long-lived internal states (Beliefs, Goals, Intentions, Decisions, Fears, Questions, Insights).\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_-]+$\" },\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"type\": { \"type\": \"string\", \"enum\": [\"BELIEF\", \"VALUE\", \"PREFERENCE\", \"GOAL\", \"FEAR\", \"DREAM\", \"INTENTION\", \"COMMITMENT\", \"QUESTION\", \"DECISION\", \"REGRET\", \"INSIGHT\", \"OBSERVATION\"] },\n        \"content\": { \"type\": \"string\", \"maxLength\": 2000 },\n        \"relatedEntityId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"confidence\": { \"type\": \"number\" },\n        \"importance\": { \"type\": \"number\" },\n        \"validFrom\": { \"type\": \"string\" },\n        \"validTo\": { \"type\": \"string\" },\n        \"status\": { \"type\": \"string\", \"enum\": [\"active\", \"superseded\", \"resolved\", \"abandoned\"] },\n        \"sourceCaptureId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"createdAt\": { \"type\": \"string\" },\n        \"updatedAt\": { \"type\": \"string\" }\n      },\n      \"required\": [\"id\", \"userId\", \"type\", \"content\", \"status\", \"createdAt\"]\n    },\n    \"Learning\": {\n      \"title\": \"Learning\",\n      \"description\": \"First-class autobiographical learning statement derived from experience.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_-]+$\" },\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"statement\": { \"type\": \"string\", \"maxLength\": 2000 },\n        \"sourceEpisodeId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"domain\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"confidence\": { \"type\": \"number\" },\n        \"importance\": { \"type\": \"number\" },\n        \"status\": { \"type\": \"string\", \"enum\": [\"active\", \"reinforced\", \"questioned\", \"superseded\"] },\n        \"sourceCaptureId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"createdAt\": { \"type\": \"string\" },\n        \"lastReinforcedAt\": { \"type\": \"string\" }\n      },\n      \"required\": [\"id\", \"userId\", \"statement\", \"createdAt\"]\n    },\n    \"Pattern\": {\n      \"title\": \"Pattern\",\n      \"description\": \"System-detected recurring observation across multiple memories.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_-]+$\" },\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"statement\": { \"type\": \"string\", \"maxLength\": 2000 },\n        \"supportingEpisodeIds\": { \"type\": \"array\" },\n        \"confidence\": { \"type\": \"number\" },\n        \"status\": { \"type\": \"string\", \"enum\": [\"candidate\", \"confirmed_by_user\", \"dismissed\"] },\n        \"firstObserved\": { \"type\": \"string\" },\n        \"lastObserved\": { \"type\": \"string\" },\n        \"createdAt\": { \"type\": \"string\" }\n      },\n      \"required\": [\"id\", \"userId\", \"statement\", \"confidence\", \"status\", \"createdAt\"]\n    },\n    \"MemoryProvenance\": {\n      \"title\": \"MemoryProvenance\",\n      \"description\": \"Full audit log tracing derived memories back to immutable capture evidence.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_-]+$\" },\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"memoryId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"memoryType\": { \"type\": \"string\", \"maxLength\": 64 },\n        \"sourceCaptureId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"sourceSpan\": { \"type\": \"string\", \"maxLength\": 2000 },\n        \"extractionMethod\": { \"type\": \"string\", \"maxLength\": 64 },\n        \"model\": { \"type\": \"string\", \"maxLength\": 64 },\n        \"confidence\": { \"type\": \"number\" },\n        \"createdAt\": { \"type\": \"string\" }\n      },\n      \"required\": [\"id\", \"userId\", \"memoryId\", \"sourceCaptureId\", \"createdAt\"]\n    }\n  },\n  \"firestore\": {\n    \"/users/{userId}/captures/{captureId}\": {\n      \"schema\": { \"$ref\": \"CaptureSession\" },\n      \"description\": \"Raw capture actions and evidence\"\n    },\n    \"/users/{userId}/episodes/{episodeId}\": {\n      \"schema\": { \"$ref\": \"Episode\" },\n      \"description\": \"Autobiographical episodes and experiences\"\n    },\n    \"/users/{userId}/entities/{entityId}\": {\n      \"schema\": { \"$ref\": \"Entity\" },\n      \"description\": \"Persistent entities in the user\'s world\"\n    },\n    \"/users/{userId}/relationships/{relationshipId}\": {\n      \"schema\": { \"$ref\": \"Relationship\" },\n      \"description\": \"First-class temporal relationships between entities\"\n    },\n    \"/users/{userId}/emotions/{emotionId}\": {\n      \"schema\": { \"$ref\": \"Emotion\" },\n      \"description\": \"Attributed emotional observations\"\n    },\n    \"/users/{userId}/states/{stateId}\": {\n      \"schema\": { \"$ref\": \"MemoryState\" },\n      \"description\": \"Long-lived internal states and questions\"\n    },\n    \"/users/{userId}/learnings/{learningId}\": {\n      \"schema\": { \"$ref\": \"Learning\" },\n      \"description\": \"Learnings derived from experience\"\n    },\n    \"/users/{userId}/patterns/{patternId}\": {\n      \"schema\": { \"$ref\": \"Pattern\" },\n      \"description\": \"Recurring patterns and themes\"\n    },\n    \"/users/{userId}/provenance/{provenanceId}\": {\n      \"schema\": { \"$ref\": \"MemoryProvenance\" },\n      \"description\": \"Audit trail and evidence provenance for derived memories\"\n    },\n    \"/users/{userId}/entries/{entryId}\": {\n      \"schema\": \"object\",\n      \"description\": \"User journal entries\"\n    },\n    \"/users/{userId}/memories/{memoryId}\": {\n      \"schema\": \"object\",\n      \"description\": \"User memories\"\n    }\n  }\n}\n"
