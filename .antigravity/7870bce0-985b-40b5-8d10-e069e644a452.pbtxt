  file_change {
    absolute_path_uri: "file:///lib/memory-engine/store.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { db } from \"@/lib/firebase\";\nimport {\n  collection,\n  doc,\n  getDoc,\n  getDocs,\n  setDoc,\n  updateDoc,\n  deleteDoc,\n  query,\n  where,\n  orderBy,\n  limit\n} from \"firebase/firestore\";\nimport {\n  CaptureSession,\n  MediaAsset,\n  Episode,\n  Entity,\n  Relationship,\n  Emotion,\n  MemoryState,\n  Learning,\n  CandidatePattern,\n  MemoryProvenance\n} from \"./types\";\n\n/**\n * Defensive payload sanitizer to strip undefined fields before Firestore operations.\n */\nexport function sanitizePayload<T>(obj: T): T {\n  return JSON.parse(\n    JSON.stringify(obj, (key, value) => {\n      return value === undefined ? null : value;\n    })\n  );\n}\n\nexport class MemoryStore {\n  private userId: string;\n\n  constructor(userId: string) {\n    if (!userId) throw new Error(\"MemoryStore requires an authenticated userId\");\n    this.userId = userId;\n  }\n\n  // --- Captures ---\n  async saveCapture(capture: CaptureSession): Promise<void> {\n    const ref = doc(db, \"users\", this.userId, \"captures\", capture.id);\n    await setDoc(ref, sanitizePayload(capture));\n  }\n\n  async getCapture(captureId: string): Promise<CaptureSession | null> {\n    const ref = doc(db, \"users\", this.userId, \"captures\", captureId);\n    const snap = await getDoc(ref);\n    return snap.exists() ? (snap.data() as CaptureSession) : null;\n  }\n\n  async listCaptures(maxResults: number = 20): Promise<CaptureSession[]> {\n    const colRef = collection(db, \"users\", this.userId, \"captures\");\n    const q = query(colRef, orderBy(\"createdAt\", \"desc\"), limit(maxResults));\n    const snap = await getDocs(q);\n    return snap.docs.map((d) => d.data() as CaptureSession);\n  }\n\n  // --- Entities ---\n  async saveEntity(entity: Entity): Promise<void> {\n    const ref = doc(db, \"users\", this.userId, \"entities\", entity.id);\n    await setDoc(ref, sanitizePayload(entity));\n  }\n\n  async updateEntity(entityId: string, updates: Partial<Entity>): Promise<void> {\n    const ref = doc(db, \"users\", this.userId, \"entities\", entityId);\n    await updateDoc(ref, sanitizePayload({ ...updates, updatedAt: new Date().toISOString() }));\n  }\n\n  async getEntity(entityId: string): Promise<Entity | null> {\n    const ref = doc(db, \"users\", this.userId, \"entities\", entityId);\n    const snap = await getDoc(ref);\n    return snap.exists() ? (snap.data() as Entity) : null;\n  }\n\n  async findEntitiesByName(name: string): Promise<Entity[]> {\n    const all = await this.listEntities();\n    const clean = name.toLowerCase().trim();\n    return all.filter((e) => {\n      if (e.canonicalName.toLowerCase() === clean) return true;\n      if (e.aliases && e.aliases.some((a) => a.toLowerCase() === clean)) return true;\n      return false;\n    });\n  }\n\n  async listEntities(filterType?: string): Promise<Entity[]> {\n    const colRef = collection(db, \"users\", this.userId, \"entities\");\n    const snap = await getDocs(colRef);\n    let docs = snap.docs.map((d) => d.data() as Entity);\n    if (filterType) {\n      docs = docs.filter((e) => e.type === filterType);\n    }\n    return docs;\n  }\n\n  async deleteEntity(entityId: string): Promise<void> {\n    const ref = doc(db, \"users\", this.userId, \"entities\", entityId);\n    await deleteDoc(ref);\n  }\n\n  // --- Episodes ---\n  async saveEpisode(episode: Episode): Promise<void> {\n    const ref = doc(db, \"users\", this.userId, \"episodes\", episode.id);\n    await setDoc(ref, sanitizePayload(episode));\n  }\n\n  async updateEpisode(episodeId: string, updates: Partial<Episode>): Promise<void> {\n    const ref = doc(db, \"users\", this.userId, \"episodes\", episodeId);\n    await updateDoc(ref, sanitizePayload({ ...updates, updatedAt: new Date().toISOString() }));\n  }\n\n  async getEpisode(episodeId: string): Promise<Episode | null> {\n    const ref = doc(db, \"users\", this.userId, \"episodes\", episodeId);\n    const snap = await getDoc(ref);\n    return snap.exists() ? (snap.data() as Episode) : null;\n  }\n\n  async listEpisodes(maxResults: number = 50): Promise<Episode[]> {\n    const colRef = collection(db, \"users\", this.userId, \"episodes\");\n    const q = query(colRef, orderBy(\"createdAt\", \"desc\"), limit(maxResults));\n    const snap = await getDocs(q);\n    return snap.docs.map((d) => d.data() as Episode);\n  }\n\n  async getEpisodesForEntity(entityId: string): Promise<Episode[]> {\n    const all = await this.listEpisodes(100);\n    return all.filter((ep) => ep.entityIds && ep.entityIds.includes(entityId));\n  }\n\n  async deleteEpisode(episodeId: string): Promise<void> {\n    const ref = doc(db, \"users\", this.userId, \"episodes\", episodeId);\n    await deleteDoc(ref);\n  }\n\n  // --- Relationships ---\n  async saveRelationship(rel: Relationship): Promise<void> {\n    const ref = doc(db, \"users\", this.userId, \"relationships\", rel.id);\n    await setDoc(ref, sanitizePayload(rel));\n  }\n\n  async getRelationship(relId: string): Promise<Relationship | null> {\n    const ref = doc(db, \"users\", this.userId, \"relationships\", relId);\n    const snap = await getDoc(ref);\n    return snap.exists() ? (snap.data() as Relationship) : null;\n  }\n\n  async listRelationships(): Promise<Relationship[]> {\n    const colRef = collection(db, \"users\", this.userId, \"relationships\");\n    const snap = await getDocs(colRef);\n    return snap.docs.map((d) => d.data() as Relationship);\n  }\n\n  async getRelationshipsForEntity(entityId: string): Promise<Relationship[]> {\n    const all = await this.listRelationships();\n    return all.filter(\n      (r) => r.sourceEntityId === entityId || r.targetEntityId === entityId\n    );\n  }\n\n  // --- Emotions ---\n  async saveEmotion(emotion: Emotion): Promise<void> {\n    const ref = doc(db, \"users\", this.userId, \"emotions\", emotion.id);\n    await setDoc(ref, sanitizePayload(emotion));\n  }\n\n  async listEmotions(maxResults: number = 50): Promise<Emotion[]> {\n    const colRef = collection(db, \"users\", this.userId, \"emotions\");\n    const q = query(colRef, orderBy(\"createdAt\", \"desc\"), limit(maxResults));\n    const snap = await getDocs(q);\n    return snap.docs.map((d) => d.data() as Emotion);\n  }\n\n  // --- Memory States (Beliefs, Goals, Questions, etc.) ---\n  async saveState(state: MemoryState): Promise<void> {\n    const ref = doc(db, \"users\", this.userId, \"states\", state.id);\n    await setDoc(ref, sanitizePayload(state));\n  }\n\n  async updateState(stateId: string, updates: Partial<MemoryState>): Promise<void> {\n    const ref = doc(db, \"users\", this.userId, \"states\", stateId);\n    await updateDoc(ref, sanitizePayload({ ...updates, updatedAt: new Date().toISOString() }));\n  }\n\n  async getState(stateId: string): Promise<MemoryState | null> {\n    const ref = doc(db, \"users\", this.userId, \"states\", stateId);\n    const snap = await getDoc(ref);\n    return snap.exists() ? (snap.data() as MemoryState) : null;\n  }\n\n  async listStates(): Promise<MemoryState[]> {\n    const colRef = collection(db, \"users\", this.userId, \"states\");\n    const snap = await getDocs(colRef);\n    return snap.docs.map((d) => d.data() as MemoryState);\n  }\n\n  async deleteState(stateId: string): Promise<void> {\n    const ref = doc(db, \"users\", this.userId, \"states\", stateId);\n    await deleteDoc(ref);\n  }\n\n  // --- Learnings ---\n  async saveLearning(learning: Learning): Promise<void> {\n    const ref = doc(db, \"users\", this.userId, \"learnings\", learning.id);\n    await setDoc(ref, sanitizePayload(learning));\n  }\n\n  async updateLearning(learningId: string, updates: Partial<Learning>): Promise<void> {\n    const ref = doc(db, \"users\", this.userId, \"learnings\", learningId);\n    await updateDoc(ref, sanitizePayload(updates));\n  }\n\n  async listLearnings(): Promise<Learning[]> {\n    const colRef = collection(db, \"users\", this.userId, \"learnings\");\n    const snap = await getDocs(colRef);\n    return snap.docs.map((d) => d.data() as Learning);\n  }\n\n  async deleteLearning(learningId: string): Promise<void> {\n    const ref = doc(db, \"users\", this.userId, \"learnings\", learningId);\n    await deleteDoc(ref);\n  }\n\n  // --- Patterns ---\n  async savePattern(pattern: CandidatePattern): Promise<void> {\n    const ref = doc(db, \"users\", this.userId, \"patterns\", pattern.id);\n    await setDoc(ref, sanitizePayload(pattern));\n  }\n\n  async listPatterns(): Promise<CandidatePattern[]> {\n    const colRef = collection(db, \"users\", this.userId, \"patterns\");\n    const snap = await getDocs(colRef);\n    return snap.docs.map((d) => d.data() as CandidatePattern);\n  }\n\n  // --- Provenance ---\n  async saveProvenance(prov: MemoryProvenance): Promise<void> {\n    const ref = doc(db, \"users\", this.userId, \"provenance\", prov.id);\n    await setDoc(ref, sanitizePayload(prov));\n  }\n\n  async getProvenanceForMemory(memoryId: string): Promise<MemoryProvenance[]> {\n    const colRef = collection(db, \"users\", this.userId, \"provenance\");\n    const snap = await getDocs(colRef);\n    return snap.docs\n      .map((d) => d.data() as MemoryProvenance)\n      .filter((p) => p.memoryId === memoryId);\n  }\n}\n"
    }
