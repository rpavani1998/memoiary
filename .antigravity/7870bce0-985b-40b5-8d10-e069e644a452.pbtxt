    replacement_chunks {
      replacement_content: "import { MemoryStore } from \"./store\";\nimport {\n  ExtractedMemoryBundle,\n  CaptureSession,\n  Entity,\n  Episode,\n  Relationship,\n  Emotion,\n  MemoryState,\n  Learning,\n  MemoryProvenance\n} from \"./types\";\n\nfunction generateId(prefix: string): string {\n  return `${prefix}_${Date.now()}_${Math.random().toString(36).substring(2, 9)}`;\n}\n\n/**\n * Memory Reconciliation Engine\n * Responsibilities:\n * - Entity Resolution (Matching aliases, names, preventing ambiguous merging)\n * - Historical Relationship Maintenance (Preserving valid_from, valid_to instead of overwriting)\n * - Belief & Decision State Evolution (Superseding previous states with provenance)\n * - Episode Linking\n */\nexport class MemoryReconciler {\n  private store: MemoryStore;\n  private userId: string;\n\n  constructor(userId: string) {\n    this.userId = userId;\n    this.store = new MemoryStore(userId);\n  }\n\n  async reconcileCapture(\n    capture: CaptureSession,\n    bundle: ExtractedMemoryBundle\n  ): Promise<{\n    createdEntities: Entity[];\n    createdEpisodes: Episode[];\n    createdRelationships: Relationship[];\n    createdEmotions: Emotion[];\n    createdStates: MemoryState[];\n    createdLearnings: Learning[];\n  }> {\n    const existingEntities = await this.store.listEntities();\n    const existingRelationships = await this.store.listRelationships();\n    const existingStates = await this.store.listStates();\n\n    const entityNameToIdMap: Map<string, string> = new Map();\n    const createdEntities: Entity[] = [];\n    const createdEpisodes: Episode[] = [];\n    const createdRelationships: Relationship[] = [];\n    const createdEmotions: Emotion[] = [];\n    const createdStates: MemoryState[] = [];\n    const createdLearnings: Learning[] = [];\n\n    // Map \"user\" directly\n    entityNameToIdMap.set(\"user\", \"user\");\n    entityNameToIdName(\"me\", \"user\");\n    entityNameToIdName(\"myself\", \"user\");\n    entityNameToIdName(\"i\", \"user\");\n\n    function entityNameToIdName(alias: string, id: string) {\n      entityNameToIdMap.set(alias.toLowerCase().trim(), id);\n    }\n\n    // 1. Resolve & Persist Entities\n    for (const extractedEntity of bundle.entities) {\n      const cleanName = extractedEntity.canonicalName.toLowerCase().trim();\n      \n      // Look for high-confidence existing entity\n      const match = existingEntities.find((e) => {\n        if (e.type !== extractedEntity.type) return false;\n        if (e.canonicalName.toLowerCase().trim() === cleanName) return true;\n        if (e.aliases && e.aliases.some((a) => a.toLowerCase().trim() === cleanName)) return true;\n        return false;\n      });\n\n      if (match) {\n        // Entity exists -> link and update lastMentionedAt\n        entityNameToIdMap.set(cleanName, match.id);\n        if (extractedEntity.aliases) {\n          extractedEntity.aliases.forEach((a) => entityNameToIdMap.set(a.toLowerCase().trim(), match.id));\n        }\n\n        // Merge any new aliases or description updates\n        const updatedAliases = Array.from(new Set([...(match.aliases || []), ...(extractedEntity.aliases || [])]));\n        await this.store.updateEntity(match.id, {\n          aliases: updatedAliases,\n          description: extractedEntity.description || match.description,\n          occupation: extractedEntity.occupation || match.occupation,\n          lastMentionedAt: capture.createdAt\n        });\n      } else {\n        // New Entity creation\n        const newEntityId = generateId(\"ent\");\n        const newEntity: Entity = {\n          id: newEntityId,\n          userId: this.userId,\n          type: extractedEntity.type,\n          canonicalName: extractedEntity.canonicalName,\n          aliases: extractedEntity.aliases || [],\n          description: extractedEntity.description,\n          occupation: extractedEntity.occupation,\n          importanceScore: 0.5,\n          confidenceScore: extractedEntity.confidence || 0.85,\n          status: \"active\",\n          sourceCaptureId: capture.id,\n          createdAt: capture.createdAt,\n          updatedAt: capture.createdAt,\n          lastMentionedAt: capture.createdAt\n        };\n\n        await this.store.saveEntity(newEntity);\n        existingEntities.push(newEntity);\n        createdEntities.push(newEntity);\n        entityNameToIdMap.set(cleanName, newEntityId);\n        if (extractedEntity.aliases) {\n          extractedEntity.aliases.forEach((a) => entityNameToIdMap.set(a.toLowerCase().trim(), newEntityId));\n        }\n\n        // Save Provenance\n        await this.saveProvenance(newEntityId, \"entity\", capture.id, extractedEntity.canonicalName, extractedEntity.confidence || 0.85);\n      }\n    }\n\n    // Helper to resolve entity id from name\n    const resolveEntityId = (name?: string): string => {\n      if (!name) return \"user\";\n      const clean = name.toLowerCase().trim();\n      return entityNameToIdMap.get(clean) || name;\n    };\n\n    // 2. Resolve & Persist Episodes\n    for (const ep of bundle.episodes) {\n      const episodeId = generateId(\"ep\");\n      const associatedIds = (ep.associatedEntityNames || [])\n        .map((name) => resolveEntityId(name))\n        .filter(Boolean);\n\n      const newEpisode: Episode = {\n        id: episodeId,\n        userId: this.userId,\n        type: ep.type || \"experience\",\n        title: ep.title || \"Untitled Experience\",\n        summary: ep.summary,\n        startTime: ep.resolvedTime || capture.createdAt,\n        timePrecision: ep.timePrecision || \"day\",\n        relativeTimeExpression: ep.relativeTimeExpression,\n        importanceScore: ep.importanceScore || 0.6,\n        entityIds: associatedIds,\n        sourceCaptureId: capture.id,\n        significance: ep.significance,\n        expectation: ep.expectation,\n        outcome: ep.outcome,\n        createdAt: capture.createdAt,\n        updatedAt: capture.createdAt\n      };\n\n      await this.store.saveEpisode(newEpisode);\n      createdEpisodes.push(newEpisode);\n\n      await this.saveProvenance(episodeId, \"episode\", capture.id, ep.title, 0.9);\n    }\n\n    // 3. Resolve & Persist Relationships (Preserving Historical Validity)\n    for (const rel of bundle.relationships) {\n      const sourceId = resolveEntityId(rel.sourceEntityName);\n      const targetId = resolveEntityId(rel.targetEntityName);\n\n      // Check if there is an existing relationship between these entities of a similar nature\n      const existingRel = existingRelationships.find(\n        (r) =>\n          r.sourceEntityId === sourceId &&\n          r.targetEntityId === targetId &&\n          r.status === \"active\"\n      );\n\n      if (existingRel) {\n        if (existingRel.relationshipType !== rel.relationshipType) {\n          // Historical transition: close out existing relationship\n          await this.store.saveRelationship({\n            ...existingRel,\n            status: \"historical\",\n            validTo: capture.createdAt,\n            updatedAt: capture.createdAt\n          });\n\n          // Create new active relationship with validFrom\n          const newRelId = generateId(\"rel\");\n          const newRel: Relationship = {\n            id: newRelId,\n            userId: this.userId,\n            sourceEntityId: sourceId,\n            targetEntityId: targetId,\n            relationshipType: rel.relationshipType,\n            strength: 0.8,\n            confidence: rel.confidence || 0.85,\n            status: \"active\",\n            validFrom: capture.createdAt,\n            validTo: null,\n            sourceCaptureId: capture.id,\n            createdAt: capture.createdAt,\n            updatedAt: capture.createdAt\n          };\n          await this.store.saveRelationship(newRel);\n          createdRelationships.push(newRel);\n          await this.saveProvenance(newRelId, \"relationship\", capture.id, `${rel.sourceEntityName} -> ${rel.relationshipType} -> ${rel.targetEntityName}`, rel.confidence || 0.85);\n        }\n      } else {\n        const newRelId = generateId(\"rel\");\n        const newRel: Relationship = {\n          id: newRelId,\n          userId: this.userId,\n          sourceEntityId: sourceId,\n          targetEntityId: targetId,\n          relationshipType: rel.relationshipType,\n          strength: 0.7,\n          confidence: rel.confidence || 0.85,\n          status: \"active\",\n          validFrom: capture.createdAt,\n          validTo: null,\n          sourceCaptureId: capture.id,\n          createdAt: capture.createdAt,\n          updatedAt: capture.createdAt\n        };\n        await this.store.saveRelationship(newRel);\n        createdRelationships.push(newRel);\n        await this.saveProvenance(newRelId, \"relationship\", capture.id, `${rel.sourceEntityName} -> ${rel.relationshipType} -> ${rel.targetEntityName}`, rel.confidence || 0.85);\n      }\n    }\n\n    // 4. Resolve & Persist Emotions\n    for (const em of bundle.emotions) {\n      const emotionId = generateId(\"emo\");\n      const subjectId = resolveEntityId(em.subjectName);\n      const targetId = em.targetEntityName ? resolveEntityId(em.targetEntityName) : undefined;\n      const episodeId = createdEpisodes[0]?.id || \"unspecified\";\n\n      const newEmotion: Emotion = {\n        id: emotionId,\n        userId: this.userId,\n        episodeId,\n        subjectEntityId: subjectId,\n        observerEntityId: \"user\",\n        targetEntityId: targetId,\n        emotionType: em.emotionType,\n        intensity: em.intensity || 0.7,\n        cause: em.cause,\n        confidence: em.confidence || 0.85,\n        sourceCaptureId: capture.id,\n        createdAt: capture.createdAt\n      };\n\n      await this.store.saveEmotion(newEmotion);\n      createdEmotions.push(newEmotion);\n      await this.saveProvenance(emotionId, \"emotion\", capture.id, `${em.subjectName} felt ${em.emotionType}`, em.confidence || 0.85);\n    }\n\n    // 5. Resolve & Persist Internal States (Beliefs, Goals, Decisions, Questions)\n    for (const st of bundle.states) {\n      const stateId = generateId(\"state\");\n      const relatedEntId = st.relatedEntityName ? resolveEntityId(st.relatedEntityName) : undefined;\n\n      // Check if this new state supersedes an existing active state of the same type\n      const contradictingState = existingStates.find(\n        (s) =>\n          s.type === st.type &&\n          s.status === \"active\" &&\n          s.relatedEntityId === relatedEntId &&\n          s.content.toLowerCase().trim() !== st.content.toLowerCase().trim()\n      );\n\n      if (contradictingState) {\n        await this.store.updateState(contradictingState.id, {\n          status: \"superseded\",\n          validTo: capture.createdAt\n        });\n      }\n\n      const newState: MemoryState = {\n        id: stateId,\n        userId: this.userId,\n        type: st.type,\n        content: st.content,\n        relatedEntityId: relatedEntId,\n        confidence: st.confidence || 0.85,\n        importance: st.importance || 0.7,\n        validFrom: capture.createdAt,\n        validTo: null,\n        status: st.status || \"active\",\n        sourceCaptureId: capture.id,\n        createdAt: capture.createdAt,\n        updatedAt: capture.createdAt\n      };\n\n      await this.store.saveState(newState);\n      createdStates.push(newState);\n      await this.saveProvenance(stateId, \"state\", capture.id, st.content, st.confidence || 0.85);\n    }\n\n    // 6. Resolve & Persist Learnings\n    for (const lr of bundle.learnings) {\n      const learningId = generateId(\"lrn\");\n      const newLearning: Learning = {\n        id: learningId,\n        userId: this.userId,\n        statement: lr.statement,\n        sourceEpisodeId: createdEpisodes[0]?.id,\n        domain: lr.domain || \"personal\",\n        confidence: lr.confidence || 0.9,\n        importance: lr.importance || 0.8,\n        status: \"active\",\n        sourceCaptureId: capture.id,\n        createdAt: capture.createdAt,\n        lastReinforcedAt: capture.createdAt\n      };\n\n      await this.store.saveLearning(newLearning);\n      createdLearnings.push(newLearning);\n      await this.saveProvenance(learningId, \"learning\", capture.id, lr.statement, lr.confidence || 0.9);\n    }\n\n    return {\n      createdEntities,\n      createdEpisodes,\n      createdRelationships,\n      createdEmotions,\n      createdStates,\n      createdLearnings\n    };\n  }\n\n  private async saveProvenance(\n    memoryId: string,\n    memoryType: string,\n    sourceCaptureId: string,\n    sourceSpan: string,\n    confidence: number\n  ) {\n    const provId = generateId(\"prov\");\n    const prov: MemoryProvenance = {\n      id: provId,\n      userId: this.userId,\n      memoryId,\n      memoryType,\n      sourceCaptureId,\n      sourceSpan,\n      extractionMethod: \"llm_structured_extraction\",\n      model: \"gemini-2.5-flash\",\n      confidence,\n      createdAt: new Date().toISOString()\n    };\n    await this.store.saveProvenance(prov);\n  }\n}\n"
    }
